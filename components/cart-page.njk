<section class="component section" data-component-id="{{ componentId }}">
  <div x-data="cartPage">
    <div class="wrap">
      <div class="section-head mb-8">
        <span class="eyebrow">{{ 'cart.eyebrow' | t }}</span>
        <h1 class="title">{{ 'cart.title' | t }}</h1>
      </div>

      <div class="flex flex-col gap-8 lg:flex-row">
        <div class="lg:w-3/4">
          <div
            x-cloak
            x-show="fullCartShowMessages"
            class="transition-opacity"
            x-transition:enter="transition ease-out duration-300 transform"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-200 transform"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
          >
            <div class="p-4 rounded-[var(--radius-card)] mb-4 text-sm" style="background: color-mix(in srgb, rgb(var(--cl-accent)) 10%, transparent); border: 1px solid color-mix(in srgb, rgb(var(--cl-accent)) 35%, transparent); color: color-mix(in srgb, rgb(var(--cl-accent)) 75%, white);">
              <template x-for="(message, index) in fullCartMessages" :key="index">
                <p x-text="message"></p>
              </template>
            </div>
          </div>

          <div>
            <div x-show="fullCartLoading" class="gcard p-10 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="inline-block size-8" viewBox="0 0 24 24" style="color: rgb(var(--cl-accent))"><path fill="none" stroke="currentColor" stroke-dasharray="16" stroke-dashoffset="16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c4.97 0 9 4.03 9 9"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.2s" values="16;0"/><animateTransform attributeName="transform" dur="1.5s" repeatCount="indefinite" type="rotate" values="0 12 12;360 12 12"/></path></svg>
            </div>

            <template x-if="!fullCartLoading">
              <div>
                <template x-if="fullCart.length === 0">
                  <div class="empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-9 opacity-40" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                    <p>{{ 'cart.empty' | t }}</p>
                    <a href="{{ '/products' | shopUrl }}" class="btn btn-ghost btn-sm mt-2">{{ 'cart.continue_shopping' | t }}</a>
                  </div>
                </template>

                <template x-if="fullCart.length > 0">
                  <div class="flex flex-col gap-4">
                    <template x-for="(cartItem, index) in fullCart" :key="index">
                      <div class="gcard p-3 sm:p-0 sm:overflow-hidden">
                        <div class="flex flex-col sm:flex-row sm:justify-between">
                          <div class="flex-1 flex gap-3 truncate">
                            <div class="flex justify-center items-center w-full max-w-28 relative sm:p-3">
                              <template x-if="cartItem.product.image_url">
                                <img :src="cartItem.product.image_url" class="w-full rounded-xl aspect-product-card-image object-product-image" loading="lazy" />
                              </template>
                              <template x-if="!cartItem.product.image_url">
                                <div class="flex justify-center items-center rounded-xl aspect-product-card-image w-full" style="background: color-mix(in srgb, rgb(var(--cl-accent)) 6%, transparent); color: color-mix(in srgb, rgb(var(--cl-accent)) 40%, transparent);">
                                  <svg xmlns="http://www.w3.org/2000/svg" class="size-10" viewBox="0 0 256 256">
                                    <path fill="currentColor" d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46ZM43.49 76l38.07-20.85l84.51 46.26L128 122.24ZM218 175.82a2 2 0 0 1-1 1.75L134 223v-90.36l36-19.71V152a6 6 0 0 0 12 0v-45.63l36-19.71Z" />
                                  </svg>
                                </div>
                              </template>
                            </div>

                            <div class="flex-1 text-left py-1 pr-2 truncate sm:py-4 sm:pr-4">
                              <div class="flex justify-between items-center gap-2">
                                <a :href="'{{ '/product/' | shopUrl }}' + cartItem.product.path" class="text-t-primary text-[0.95rem] font-semibold truncate hover:text-accent-500 transition">
                                  <span x-text="cartItem.product.name"></span>
                                </a>
                                <button type="button" @click="removeItem(index)" class="icon-btn !size-8 sm:!hidden" aria-label="{{ 'common.remove' | t }}">
                                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 18 18 6M6 6l12 12"/></svg>
                                </button>
                              </div>
                              <p class="text-muted text-sm truncate mt-0.5">
                                <span x-text="cartItem.variant.name"></span>
                              </p>
                              <template x-if="getAvailableVolumeDiscount(index)">
                                <div class="text-faint text-xs truncate mt-1">
                                  <span x-html="'{{ 'cart.volume_discount_hint' | t | jsEscape }}'.replace('{n}', getAvailableVolumeDiscount(index)?.quantity - cartItem.quantity).replace('{percent}', getAvailableVolumeDiscount(index)?.percentage)"></span>
                                </div>
                              </template>
                              <template x-for="deal in getDealsForItem(index)" :key="deal.id">
                                <div>
                                  <div x-show="cartItem.quantity < deal.buy_quantity + deal.discounted_quantity" class="text-faint text-xs truncate mt-1">
                                    <span x-html="'{{ 'cart.deal_hint' | t | jsEscape }}'.replace('{n}', deal.buy_quantity + deal.discounted_quantity - cartItem.quantity)"></span>
                                    <span x-text="deal.percentage == 100 ? '{{ 'cart.deal_get_free' | t | jsEscape }}'.replace('{n}', deal.discounted_quantity) : '{{ 'cart.deal_get_discount' | t | jsEscape }}'.replace('{n}', deal.discounted_quantity).replace('{percent}', deal.percentage)"></span>
                                    (<span x-text="deal.name"></span>)
                                  </div>
                                  <div x-show="cartItem.quantity >= deal.buy_quantity + deal.discounted_quantity" class="flex items-center gap-1 text-xs mt-1" style="color: rgb(var(--cl-accent))">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                                    <span x-text="deal.name"></span>
                                  </div>
                                </div>
                              </template>
                              <template x-if="cartItem.addons && cartItem.addons.length > 0">
                                <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                  <template x-for="(addon, addonIndex) in cartItem.addons" :key="addonIndex">
                                    <span class="pill !h-6 !text-[0.7rem]">
                                      <span x-text="addon.product.name"></span>
                                    </span>
                                  </template>
                                </div>
                              </template>
                            </div>
                          </div>

                          <div class="flex items-center justify-between gap-4 px-1 pb-1 pt-3 mt-2 border-t sm:border-t-0 sm:justify-end sm:pl-0 sm:py-0 sm:mt-0 md:gap-6 lg:gap-8 sm:pr-6" style="border-color: color-mix(in srgb, rgb(var(--cl-t-primary)) 7%, transparent);">
                            <div class="max-w-32 flex rounded-[var(--radius-input)] overflow-hidden border" style="border-color: color-mix(in srgb, rgb(var(--cl-t-primary)) 10%, transparent);">
                              <button
                                type="button"
                                @click="changeQuantity(index, cartItem.quantity - 1)"
                                :disabled="cartItem.quantity <= getMinQuantity(index)"
                                class="size-9 flex justify-center items-center transition-colors disabled:pointer-events-none disabled:opacity-40 hover:text-white"
                                style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 5%, transparent);"
                                :aria-label="'Decrease quantity'"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><path fill="currentColor" d="M6 13q-.425 0-.712-.288T5 12t.288-.712T6 11h12q.425 0 .713.288T19 12t-.288.713T18 13z"/></svg>
                              </button>
                              <input
                                type="number"
                                x-model.number="cartItem.quantity"
                                class="w-14 text-center text-sm focus:outline-none py-1.5"
                                style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 3%, transparent);"
                                aria-label="{{ 'common.quantity' | t }}"
                              />
                              <button
                                type="button"
                                @click="changeQuantity(index, cartItem.quantity + 1)"
                                :disabled="cartItem.quantity >= getMaxQuantity(index)"
                                class="size-9 flex justify-center items-center transition-colors disabled:pointer-events-none disabled:opacity-40"
                                style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 5%, transparent);"
                                aria-label="Increase quantity"
                              >
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><path fill="currentColor" d="M11 13H6q-.425 0-.712-.288T5 12t.288-.712T6 11h5V6q0-.425.288-.712T12 5t.713.288T13 6v5h5q.425 0 .713.288T19 12t-.288.713T18 13h-5v5q0 .425-.288.713T12 19t-.712-.288T11 18z"/></svg>
                              </button>
                            </div>

                            <p class="price-tag text-center sm:min-w-20">
                              <span x-text="appCurrency.format(getItemSinglePrice(index), cartItem.product.currency)"></span>
                            </p>

                            <button
                              type="button"
                              @click="removeItem(index)"
                              class="icon-btn !size-8 !hidden sm:!inline-flex"
                              aria-label="{{ 'common.remove' | t }}"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 18 18 6M6 6l12 12"/></svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    </template>
                  </div>
                </template>
              </div>
            </template>
          </div>
        </div>

        <div class="lg:w-1/4">
          <div class="flex flex-col gap-4 lg:sticky lg:top-24">
            <div class="gcard gcard-glow p-5 md:p-6">
              <form @submit.prevent="checkout">
                <div class="mb-5 pb-4" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 8%, transparent);">
                  <label class="foot-title block">{{ 'cart.your_order' | t }}</label>
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <span class="text-sm text-muted">{{ 'common.subtotal' | t }}</span>
                      <span class="text-sm">
                        <span x-text="appCurrency.format(cartSubtotalPrice, cartCurrency)"></span>
                      </span>
                    </div>
                    <template x-for="deal in quantityDeals" :key="'qd-' + deal.id">
                      <div x-show="getQuantityDealDiscount(deal) > 0" class="flex items-center justify-between mb-1.5">
                        <span class="text-sm text-muted" x-text="deal.name"></span>
                        <span class="text-sm" style="color: rgb(var(--cl-accent))">-<span x-text="appCurrency.format(getQuantityDealDiscount(deal), cartCurrency)"></span></span>
                      </div>
                    </template>
                    <template x-for="offer in bundleOffers" :key="'bo-' + offer.id">
                      <div x-show="getBundleDiscount(offer) > 0" class="flex items-center justify-between mb-1.5">
                        <span class="text-sm text-muted" x-text="offer.name"></span>
                        <span class="text-sm" style="color: rgb(var(--cl-accent))">-<span x-text="appCurrency.format(getBundleDiscount(offer), cartCurrency)"></span></span>
                      </div>
                    </template>
                    <div x-show="cartTotalPrice < cartSubtotalPrice" class="flex items-center justify-between mb-1.5 pt-2" style="border-top: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 8%, transparent);">
                      <span class="text-sm font-semibold">{{ 'common.total' | t }}</span>
                      <span class="text-sm font-semibold">
                        <span x-text="appCurrency.format(cartTotalPrice, cartCurrency)"></span>
                      </span>
                    </div>
                  </div>
                </div>

                {% if altcha %}
                  <div
                    x-cloak
                    x-show="!altchaPayload"
                    class="transition-opacity"
                    x-transition:enter="transition ease-out duration-300 transform"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-200 transform"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                  >
                    <altcha-widget
                      challengejson='{{ altcha | json }}'
                      auto="onload"
                      hidefooter="true"
                      hidelogo="true"
                      x-ref="altcha"
                    ></altcha-widget>
                  </div>
                {% endif %}

                <div
                  x-cloak
                  x-show="submitError"
                  class="transition-opacity"
                  x-transition:enter="transition ease-out duration-300 transform"
                  x-transition:enter-start="opacity-0"
                  x-transition:enter-end="opacity-100"
                  x-transition:leave="transition ease-in duration-200 transform"
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0"
                >
                  <div class="p-4 rounded-[var(--radius-input)] mt-4 text-sm" style="background: color-mix(in srgb, rgb(var(--status-error)) 15%, transparent); color: rgb(var(--status-error));">
                    <span x-text="submitError"></span>
                  </div>
                </div>

                <button
                  type="submit"
                  :disabled="fullCartLoading || fullCart.length === 0 || isSubmitting || submitDisabled"
                  class="btn btn-bloom btn-block mt-2"
                >
                  <span>{{ 'cart.checkout' | t }}</span>
                  <template x-if="!isSubmitting">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 256 256"><path d="M230.14,58.87A8,8,0,0,0,224,56H62.68L56.6,22.57A8,8,0,0,0,48.73,16H24a8,8,0,0,0,0,16h18L67.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42A27.75,27.75,0,0,0,160,204a28,28,0,1,0,28-28H91.17a8,8,0,0,1-7.87-6.57L80.13,152h116a24,24,0,0,0,23.61-19.71l12.16-66.86A8,8,0,0,0,230.14,58.87ZM104,204a12,12,0,1,1-12-12A12,12,0,0,1,104,204Zm96,0a12,12,0,1,1-12-12A12,12,0,0,1,200,204Zm4-74.57A8,8,0,0,1,196.1,136H77.22L65.59,72H214.41Z"></path></svg>
                  </template>
                  <template x-if="isSubmitting">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>
                  </template>
                </button>
              </form>
            </div>

            <template x-if="bundleOffers.length > 0">
              <div class="flex flex-col gap-4">
                <template x-for="offer in bundleOffers" :key="offer.id">
                  <div class="gcard p-5">
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class="text-sm font-semibold" x-text="offer.name"></span>
                      <div class="flex items-center gap-2 flex-shrink-0">
                        <span class="pill pill-accent !h-6 !text-[0.7rem] font-bold"
                          x-text="offer.type === 'percentage' ? '-' + offer.discount + '%' : appCurrency.format(offer.discount, cartCurrency)">
                        </span>
                        <template x-if="offer.ends_at">
                          <span class="text-xs text-faint" x-text="'{{ 'cart.offer_ends' | t | jsEscape }}'.replace('{date}', new Date(offer.ends_at).toLocaleDateString())"></span>
                        </template>
                      </div>
                    </div>
                    <ul class="flex flex-col gap-2">
                      <template x-for="item in offer.items" :key="item.id">
                        <li class="flex items-center gap-3">
                          <template x-if="item.image_url">
                            <img :src="item.image_url" :alt="item.name" class="size-8 rounded-lg object-cover flex-shrink-0">
                          </template>
                          <template x-if="!item.image_url">
                            <div class="size-8 rounded-lg flex-shrink-0" style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 6%, transparent);"></div>
                          </template>
                          <span class="flex-1 text-xs font-medium truncate" x-text="item.name + (item.quantity > 1 ? ' ×' + item.quantity : '')"></span>
                          <template x-if="item.in_cart">
                            <span class="flex items-center gap-1 text-xs font-medium flex-shrink-0" style="color: rgb(var(--cl-accent))">
                              <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                              {{ 'product.in_cart' | t }}
                            </span>
                          </template>
                          <template x-if="!item.in_cart">
                            <a
                              :href="item.path ? '{{ '/product/' | shopUrl }}' + item.path : '#'"
                              class="btn btn-ghost btn-sm !h-7 !px-2.5 !text-[0.72rem]"
                            >{{ 'common.add' | t }}</a>
                          </template>
                        </li>
                      </template>
                    </ul>
                    <div x-show="isBundleComplete(offer.id)" class="flex items-center justify-center gap-2 text-sm py-1" style="color: rgb(var(--cl-accent))">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                      {{ 'product.bundle_discount_applied' | t }}
                    </div>
                  </div>
                </template>
              </div>
            </template>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('cartPage', () => ({
      fullCart: [],
      quantityDeals: [],
      bundleOffers: [],
      fullCartLoading: false,
      fullCartMessages: [],
      fullCartShowMessages: false,
      isSubmitting: false,
      submitError: null,
      submitDisabled: false,
      altchaPayload: null,

      init: function () {
        if (this.appCart.items.length > 0) {
          this.fetchFullCart();
        }

        {% if altcha %}
          this.addAltchaEventListener();
        {% endif %}

        window.addEventListener('pageshow', (event) => {
          if (event.persisted) {
            this.isSubmitting = false;
          }
        });

        /* Keep totals in sync when a product is added from the recommendations marquee */
        window.addEventListener('sf-cart-changed', () => {
          if (this.appCart.items.length > 0) {
            this.fetchFullCart();
          }
        });
      },

      fetchFullCart: async function () {
        this.fullCartLoading = true;
        this.fullCartMessages = [];
        this.fullCartShowMessages = false;

        const url = new URL('{{ '/v1/cart' | apiInternalUrl }}');
        url.searchParams.append('shopId', '{{ shop.id }}');
        url.searchParams.append('cart', JSON.stringify(this.appCart.items));

        try {
          const response = await fetch(url, {
            method: 'GET',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
            },
          });

          const responseData = await response.json();

          if (responseData?.messages && responseData.messages.length > 0) {
            this.fullCartMessages = responseData.messages;
            this.fullCartShowMessages = true;
            setTimeout(() => {
              this.fullCartShowMessages = false;
            }, 5000);
          }

          // Update full cart state (this one contains product names, images, etc.)
          this.fullCart = responseData.fullCart;

          this.quantityDeals = responseData.quantity_deals || [];
          this.bundleOffers = responseData.bundle_offers || [];

          // Update global cart state
          this.appCart.set(responseData.cart);
        } catch (error) {
          console.error(error);
        } finally {
          this.fullCartLoading = false;
        }
      },

      getDealsForItem: function (index) {
        const item = this.fullCart[index];
        return this.quantityDeals.filter(d => d.variant_id !== null && d.variant_id === item.variantId);
      },

      getQuantityDealDiscount: function (deal) {
        const bundleSize = deal.buy_quantity + deal.discounted_quantity;
        let totalQty;
        if (deal.variant_id !== null) {
          const item = this.fullCart.find(i => i.variantId === deal.variant_id);
          totalQty = item ? item.quantity : 0;
        } else {
          totalQty = this.fullCart.reduce((s, i) => s + i.quantity, 0);
        }
        let applications = Math.floor(totalQty / bundleSize);
        if (deal.max_uses_per_cart) applications = Math.min(applications, deal.max_uses_per_cart);
        if (applications === 0) return 0;

        let unitPrice;
        if (deal.variant_id !== null) {
          const idx = this.fullCart.findIndex(i => i.variantId === deal.variant_id);
          unitPrice = idx >= 0 ? this.getItemSinglePrice(idx) : 0;
        } else {
          const prices = this.fullCart.map((_, idx) => this.getItemSinglePrice(idx)).sort((a, b) => a - b);
          unitPrice = prices[0] || 0;
        }
        return applications * deal.discounted_quantity * unitPrice * (deal.percentage / 100);
      },

      getBundleDiscount: function (offer) {
        if (!offer.active || offer.applications === 0) return 0;
        if (offer.type === 'percentage') {
          let bundleItemsTotal = 0;
          for (const item of offer.items) {
            const cartItem = item.type === 'variant'
              ? this.fullCart.find(i => i.variantId === item.id)
              : this.fullCart.find(i => i.productId === item.id);
            if (cartItem) {
              bundleItemsTotal += this.getItemSinglePrice(this.fullCart.indexOf(cartItem)) * (item.quantity || 1);
            }
          }
          return offer.applications * bundleItemsTotal * (offer.discount / 100);
        }
        return offer.applications * offer.discount;
      },

      isBundleComplete: function (offerId) {
        const offer = this.bundleOffers.find(o => o.id === offerId);
        if (!offer) return false;
        return offer.items.every(item => {
          const required = item.quantity || 1;
          const entry = item.type === 'variant'
            ? this.fullCart.find(i => i.variantId === item.id)
            : this.fullCart.find(i => i.productId === item.id);
          return entry && entry.quantity >= required;
        });
      },

      getAvailableVolumeDiscount: function (index) {
        const item = this.fullCart[index];

        if (item.variant.volume_discounts) {
          const volumeDiscounts = [...item.variant.volume_discounts].sort((a, b) => a.quantity - b.quantity);

          for (const volumeDiscount of volumeDiscounts) {
            if (item.quantity < parseInt(volumeDiscount.quantity)) {
              return volumeDiscount;
            }
          }
        }

        return null;
      },

      getAppliedVolumeDiscount: function (index) {
        const item = this.fullCart[index];

        if (item.variant.volume_discounts) {
          const volumeDiscounts = [...item.variant.volume_discounts].sort((a, b) => b.quantity - a.quantity);

          for (const volumeDiscount of volumeDiscounts) {
            if (item.quantity >= parseInt(volumeDiscount.quantity)) {
              return volumeDiscount;
            }
          }
        }

        return null;
      },

      getMinQuantity: function (index) {
        const item = this.fullCart[index];

        const min = item.variant.quantity_min || 1;

        if (item.variant.stock === 0) {
          return 0;
        }

        return min;
      },

      getMaxQuantity: function (index) {
        const item = this.fullCart[index];

        const max = item.variant.quantity_max || 10000;

        if (item.variant.stock === 0) {
          return 0;
        }

        if (item.product.hide_stock_count) {
          return max;
        }

        if (item.variant.stock === -1) {
          return max;
        }

        return Math.min(max, item.variant.stock);
      },

      changeQuantity: function (index, quantity) {
        const min = this.getMinQuantity(index);
        const max = this.getMaxQuantity(index);
        const newQuantity = Math.min(Math.max(min, quantity), max);

        const item = this.fullCart[index];

        this.fullCart[index].quantity = newQuantity;
        this.appCart.editQuantity(item.variantId, newQuantity);
      },

      removeItem: function (index) {
        const item = this.fullCart[index];

        this.fullCart.splice(index, 1);

        if (item.addons) {
          item.addons.forEach((addon) => {
            this.appCart.remove(addon.variantId ?? addon.variant.id, item.variant.id);
          });
        }

        this.appCart.remove(item.variant.id);
      },

      getItemSinglePrice: function (index) {
        const item = this.fullCart[index];

        const volumeDiscount = this.getAppliedVolumeDiscount(index);

        if (volumeDiscount) {
          return item.variant.price * (1 - volumeDiscount.percentage / 100);
        }

        return item.variant.price;
      },

      get cartCurrency() {
        return this.fullCart.length > 0 ? this.fullCart[0].product.currency : 'USD';
      },

      get cartSubtotalPrice() {
        return this.fullCart.reduce((acc, item) => {
          const itemSinglePrice = this.getItemSinglePrice(this.fullCart.indexOf(item));
          const itemAddonsPrice = item.addons ? item.addons.reduce((sum, addon) => sum + addon.variant.price, 0) : 0;
          return acc + (item.quantity * itemSinglePrice) + itemAddonsPrice;
        }, 0);
      },

      get cartTotalPrice() {
        const dealDiscount = this.quantityDeals.reduce((s, d) => s + this.getQuantityDealDiscount(d), 0);
        const bundleDiscount = this.bundleOffers.reduce((s, o) => s + this.getBundleDiscount(o), 0);
        return Math.max(0, this.cartSubtotalPrice - dealDiscount - bundleDiscount);
      },

      addAltchaEventListener: function () {
        this.$refs.altcha.addEventListener('statechange', (event) => {
          if (event.detail.state === 'verifying') {
            this.submitDisabled = true;
          } else if (event.detail.state === 'verified') {
            this.submitDisabled = false;
            this.altchaPayload = event.detail.payload;
          }
        });
      },

      generateRecaptchaToken: async function () {
        return new Promise((resolve) => {
          grecaptcha.ready(
            () =>
              void (async () => {
                const token = await grecaptcha.execute(
                  '{{ shop.recaptcha_key }}',
                  { action: 'checkout_s{{ shop.id }}' },
                );

                resolve(token);
              })(),
          );
        });
      },

      checkout: async function () {
        if (this.isSubmitting) {
          return;
        }

        const formData = {
          cart: this.appCart.items,
          currency: this.appCurrency.currency,
          shopId: '{{ shop.id }}',
          source: 'storefront',
        };

        if (window.shopCustomer?.email) {
          formData.email = window.shopCustomer.email;
        }

        {% if altcha %}
          if (this.altchaPayload) {
            formData.altcha = this.altchaPayload;
          }
        {% elif shop.recaptcha_key %}
          try {
            formData.recaptchaToken = await this.generateRecaptchaToken();
          } catch (error) {
            this.submitError = {{ ('common.recaptcha_error' | t) | json }};
            this.isSubmitting = false;
            return;
          }
        {% endif %}

        try {
          this.isSubmitting = true;

          const response = await fetch('{{ '/v1/checkout' | apiInternalUrl }}', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData),
          });

          const responseData = await response.json();

          if (responseData.url) {
            localStorage.setItem('cart', JSON.stringify([]));
            window.location.href = responseData.url;
          } else {
            this.isSubmitting = false;
            this.submitError = responseData?.message || {{ ('common.request_error' | t) | json }};

            if (responseData?.error == 'captcha_verification_failed') {
              setTimeout(() => window.location.reload(), 1000);
            }
          }
        } catch (error) {
          console.error(error);
          this.isSubmitting = false;
          this.submitError = {{ ('common.unexpected_error' | t) | json }};
        }
      }
    }));

    Alpine.data('sfCartRec', (cfg) => ({
      cfg: cfg || {},
      paused: false,
      reduced: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      addedId: null,
      base: [],
      empty: false,

      get railCards() {
        const inCart = new Set((this.appCart.items || []).map(i => i.productId));
        return this.base
          .filter(p => !inCart.has(p.id))
          .map(p => ({ ...p, link: p.link || ('{{ '/product/' | shopUrl }}' + p.path) }));
      },

      quickAdd(p) {
        if (!p.vid || this.addedId === p.id) return;
        try { this.appCart.add(p.id, p.vid, 1); } catch (e) { return; }
        this.addedId = p.id;
        window.dispatchEvent(new CustomEvent('sf-cart-changed'));
        setTimeout(() => { if (this.addedId === p.id) this.addedId = null; }, 1800);
      },

      init() {
        let items = Array.isArray(this.cfg.items) ? this.cfg.items : [];
        /* Normalize: pick the license/variant fields client-side */
        items = items.map(p => {
          const variants = Array.isArray(p.variants) ? p.variants : [];
          const inStock = variants.find(v => v.stock !== 0);
          return {
            id: p.id,
            name: p.name,
            path: p.path,
            link: p.link || (p.path ? '{{ '/product/' | shopUrl }}' + p.path : (p.url || '#')),
            price: p.min_price || p.price,
            currency: p.currency || 'USD',
            image: p.image || p.image_url || '',
            variant: variants.length === 1 ? (variants[0].name || '') : '',
            vid: inStock ? inStock.id : null
          };
        });
        /* Fallback: SellAuth's real "recently viewed" products */
        if (!items.length) {
          try { items = JSON.parse(localStorage.getItem('recently_viewed') || '[]'); } catch (e) { items = []; }
          items = (Array.isArray(items) ? items : []).slice(0, 12).map(p => ({
            id: p.id, name: p.name, path: null, link: p.url || '#',
            price: p.price, currency: p.currency, image: p.image, variant: '', vid: null
          })).filter(p => p.name);
        }
        this.base = items.slice(0, 12);
        this.empty = this.base.length === 0;
      },
    }));
  });
</script>