<section class="v6-faq-contact component" data-component-id="{{ componentId }}">
  <div class="v6-faq-contact__card v6-spot-border">
    <div class="v6-faq-contact__glow" aria-hidden="true"></div>
    {% if properties.badge_text %}<span class="v6-eyebrow"><i></i>{{ properties.badge_text | renderString }}</span>{% endif %}
    {% if properties.title %}<h2>{{ properties.title | renderString }}</h2>{% endif %}
    {% if properties.subtitle %}<p>{{ properties.subtitle | renderString }}</p>{% endif %}

    {% if (properties.show_contact_button and properties.contact_text) or (properties.show_discord_button and properties.discord_text) %}
      <div class="v6-faq-contact__actions">
        {% if properties.show_contact_button and properties.contact_text %}
          <a class="v6-button v6-button--primary" href="{{ properties.contact_link | shopUrl }}" {% if properties.contact_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <i class="fa-solid fa-headset"></i><span>{{ properties.contact_text }}</span><i class="fa-solid fa-arrow-right"></i>
          </a>
        {% endif %}
        {% if properties.show_discord_button and properties.discord_text %}
          <a class="v6-button v6-button--secondary" href="{{ properties.discord_link }}" {% if properties.discord_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <i class="fa-brands fa-discord"></i><span>{{ properties.discord_text }}</span>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>