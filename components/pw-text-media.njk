<section id="{{ componentId }}" class="component ab-section pw-text-media {{ 'pw-media-left' if properties.media_side == 'left' }}" data-component-id="{{ componentId }}" {% render_snippet 'ab-section-style.njk' %}>
  <div class="pw-media-copy">{% if properties.eyebrow %}<p class="ab-eyebrow">{{ properties.eyebrow }}</p>{% endif %}<h2>{{ properties.title }}</h2>{% if properties.description %}<p class="ab-muted pw-body">{{ properties.description }}</p>{% endif %}<div class="ab-actions">{% if properties.primary_label %}<a class="ab-button ab-primary" href="{{ (properties.primary_link or '/#products') | shopUrl }}">{{ properties.primary_label }} <span aria-hidden="true">↗</span></a>{% endif %}{% if properties.secondary_label %}<a class="ab-button" href="{{ (properties.secondary_link or '/status') | shopUrl }}">{{ properties.secondary_label }} <span aria-hidden="true">→</span></a>{% endif %}</div></div>
  <div class="pw-media-frame" style="--pw-ratio:{{ properties.ratio or '4/3' }}">{% if properties.video_url %}<video controls playsinline preload="metadata" {% if properties.image %}poster="{{ properties.image | imageUrl }}"{% endif %} aria-label="{{ properties.image_alt or properties.title }}"><source src="{{ properties.video_url }}">{% if properties.captions_url %}<track kind="captions" src="{{ properties.captions_url }}" srclang="en" label="English" default>{% endif %}Your browser does not support this video.</video>{% elif properties.image %}<img src="{{ properties.image | imageUrl }}" alt="{{ properties.image_alt or '' }}" loading="lazy">{% else %}<div class="pw-media-placeholder"><span>Image or video</span><small>Add your media in the theme editor</small></div>{% endif %}</div>
</section>