{# ============================================================
   Store Recommendations — "You may also like" rail.

   Zero-framework: plain server-rendered HTML + vanilla JS.
   NOTE: sortedItems is a GLOBAL on every template (full catalog),
   so the server branch is gated to catalog templates (shop,
   products) where first-of-catalog cards make sense. On all other
   templates (cart, custom pages, ...) the cards resolve
   client-side from SellAuth's native "recently_viewed" history —
   real products the visitor actually viewed, never invented.

   Layout: contained inside .wrap, head centered, cards centered
   when they fit, otherwise a swipeable/arrow scroll rail with
   edge fades and scroll snap. The section starts `hidden` and is
   revealed by vanilla JS only when cards exist, so an empty state
   never shows a blank box. Honors prefers-reduced-motion.
   ============================================================ #}
{% set _srec = [] %}
{% if sortedItems and templateName in ['shop', 'products'] %}
  {% for p in sortedItems %}
    {% if _srec | length < 12 and p.type != 'group' and p.visibility != 'hidden' %}
      {% set _ = _srec.push({ id: p.id, name: p.name, path: p.path, price: p.min_price, max_price: p.max_price, currency: p.currency, image: (p.image_urls[0] if p.image_urls and p.image_urls | length > 0 else (p.image_url or '')), variant: (p.variants[0].name if p.variants and p.variants | length == 1 else '') }) %}
    {% endif %}
  {% endfor %}
{% endif %}

<section
  id="{{ componentId }}"
  class="component section-tight sf-cr"
  data-component-id="{{ componentId }}"
  data-sf-cr-cta="{{ properties.cta_label if properties.cta_label else 'View' }}"
  hidden
>
  <div class="wrap">
    <div class="sf-cr__head">
      <div class="sf-cr__head-text">
        <h2>{{ (properties.heading if properties.heading else 'You may also like') | renderString }}</h2>
        <p>{{ (properties.subheading if properties.subheading else 'More from the store — picked for you.') | renderString }}</p>
      </div>
    </div>
    <div class="sf-cr__frame">
      <div
        class="sf-cr__viewport"
        data-sf-cr-viewport
        tabindex="0"
        role="region"
        aria-label="Product recommendations"
      >
        <div class="sf-cr__track">
          <div class="sf-cr__group sf-cr__group--live">
            {% if _srec | length > 0 %}
              {% for p in _srec %}
                <div class="sf-cr__card">
                  <a href="{{ ('/product/' + p.path) | shopUrl }}" class="sf-cr__media" tabindex="-1">
                    {% if p.image %}
                      <img src="{{ p.image }}" alt="" loading="lazy" />
                    {% else %}
                      <span class="sf-cr__media-ph"><i class="fa-solid fa-gamepad" aria-hidden="true"></i></span>
                    {% endif %}
                  </a>
                  <div class="sf-cr__info">
                    <a href="{{ ('/product/' + p.path) | shopUrl }}" class="sf-cr__name">{{ p.name }}</a>
                    {% if p.variant %}<span class="sf-cr__variant">{{ p.variant }}</span>{% endif %}
                    {% if p.price | isNumber and p.max_price | isNumber and p.max_price != p.price %}
                      <span class="sf-cr__price">{{ formatPrice(p.price, p.currency) }} &ndash; {{ formatPrice(p.max_price, p.currency) }}</span>
                    {% elif p.price | isNumber %}
                      <span class="sf-cr__price">{{ formatPrice(p.price, p.currency) }}</span>
                    {% endif %}
                  </div>
                  <div class="sf-cr__actions">
                    <a href="{{ ('/product/' + p.path) | shopUrl }}" class="sf-cr__view">{{ properties.cta_label if properties.cta_label else 'View' }}</a>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>
      <button type="button" class="sf-cr__arrow" data-sf-cr-prev aria-label="Previous products" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="sf-cr__arrow" data-sf-cr-next aria-label="Next products" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('{{ componentId }}');
    if (!section) return;

    var viewport = section.querySelector('[data-sf-cr-viewport]');
    var group = section.querySelector('.sf-cr__group--live');
    var prevBtn = section.querySelector('[data-sf-cr-prev]');
    var nextBtn = section.querySelector('[data-sf-cr-next]');
    if (!viewport || !group) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
                  document.documentElement.dataset.motion === 'off';

    /* ---- 1. Client-side fill for templates without catalog context:
            SellAuth's real recently-viewed products ---- */
    if (!group.children.length) {
      var viewed = [];
      try { viewed = JSON.parse(localStorage.getItem('recently_viewed') || '[]'); } catch (e) { viewed = []; }
      (Array.isArray(viewed) ? viewed : []).slice(0, 12).forEach(function (p) {
        if (!p.name) return;
        var card = document.createElement('div');
        card.className = 'sf-cr__card';
        var a = document.createElement('a');
        a.className = 'sf-cr__media';
        a.setAttribute('tabindex', '-1');
        a.href = p.url || '#';
        if (p.image) {
          var img = document.createElement('img');
          img.src = p.image; img.loading = 'lazy'; img.alt = '';
          a.appendChild(img);
        } else {
          var ph = document.createElement('span');
          ph.className = 'sf-cr__media-ph';
          ph.innerHTML = '<i class="fa-solid fa-gamepad" aria-hidden="true"></i>';
          a.appendChild(ph);
        }
        var info = document.createElement('div');
        info.className = 'sf-cr__info';
        var name = document.createElement('a');
        name.className = 'sf-cr__name';
        name.href = p.url || '#';
        name.textContent = p.name;
        info.appendChild(name);
        if (p.price != null && !isNaN(parseFloat(p.price))) {
          var price = document.createElement('span');
          price.className = 'sf-cr__price';
          price.textContent = '$' + parseFloat(p.price).toFixed(2);
          info.appendChild(price);
        }
        card.appendChild(a);
        card.appendChild(info);
        var actions = document.createElement('div');
        actions.className = 'sf-cr__actions';
        var view = document.createElement('a');
        view.className = 'sf-cr__view';
        view.href = p.url || '#';
        view.textContent = section.dataset.sfCrCta || 'View';
        actions.appendChild(view);
        card.appendChild(actions);
        group.appendChild(card);
      });
    }

    /* ---- 2. Remove entirely if nothing to show ---- */
    if (!group.children.length) { section.remove(); return; }
    section.hidden = false;

    /* ---- 3. Centered when cards fit; scroll rail + arrows when they don't ---- */
    var isOverflowing = function () {
      return viewport.scrollWidth > viewport.clientWidth + 1;
    };

    var updateArrows = function () {
      if (!prevBtn || !nextBtn) return;
      var max = viewport.scrollWidth - viewport.clientWidth;
      prevBtn.hidden = !isOverflowing();
      nextBtn.hidden = !isOverflowing();
      prevBtn.disabled = viewport.scrollLeft <= 2;
      nextBtn.disabled = viewport.scrollLeft >= max - 2;
    };

    var update = function () {
      section.classList.toggle('sf-cr--overflow', isOverflowing());
      updateArrows();
    };

    var scrollByCards = function (dir) {
      var card = group.children[0];
      var gap = parseFloat(getComputedStyle(group).columnGap || getComputedStyle(group).gap) || 14;
      var w = card ? card.getBoundingClientRect().width + gap : 244;
      var perView = Math.max(1, Math.floor((viewport.clientWidth + gap) / w));
      viewport.scrollBy({ left: dir * w * perView, behavior: reduced ? 'auto' : 'smooth' });
    };

    if (prevBtn) prevBtn.addEventListener('click', function () { scrollByCards(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollByCards(1); });

    viewport.addEventListener('scroll', function () {
      window.requestAnimationFrame(updateArrows);
    }, { passive: true });

    viewport.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); scrollByCards(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); scrollByCards(1); }
    });

    var resizeTimer = null;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(update, 120);
    });

    update();
  })();
</script>