<section id="{{ componentId }}" class="component section" data-component-id="{{ componentId }}">
  <div class="wrap">
    <div class="section-head {{ 'center' if properties.center_head }}">
      <span class="eyebrow {{ 'eyebrow-centered' if properties.center_head }}">{{ properties.eyebrow if properties.eyebrow else 'categories.eyebrow' | t }}</span>
      {% if properties.title %}
        <h2 class="title">{{ properties.title | renderString }}</h2>
      {% endif %}
      {% if properties.subtitle %}
        <p class="sub">{{ properties.subtitle | renderString }}</p>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 {{ 'justify-items-center' if properties.centered }}">
      {% for category in categories %}
        <div class="w-full">
          <a class="pcard block h-full" href="{{ category.url }}">
            <div class="pcard-media">
              {% if category.image_url %}
                <img src="{{ category.image_url }}" alt="{{ category.name }}" class="aspect-video w-full object-cover" loading="lazy" />
              {% else %}
                <div class="flex justify-center items-center aspect-video" style="background: color-mix(in srgb, rgb(var(--cl-accent)) 5%, transparent);">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-16" viewBox="0 0 256 256" style="color: color-mix(in srgb, rgb(var(--cl-accent)) 40%, transparent)">
                    <path fill="currentColor" d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46ZM43.49 76l38.07-20.85l84.51 46.26L128 122.24ZM218 175.82a2 2 0 0 1-1 1.75L134 223v-90.36l36-19.71V152a6 6 0 0 0 12 0v-45.63l36-19.71Z"/>
                  </svg>
                </div>
              {% endif %}
            </div>
            <div class="pcard-body">
              <h3 class="pcard-title">{{ category.name }}</h3>
              {% if category.description %}
                <p class="pcard-desc">{{ category.description | striptags | trim | truncate(110) }}</p>
              {% endif %}
              <div class="pcard-meta">
                <span class="text-sm font-semibold inline-flex items-center gap-1.5" style="color: rgb(var(--cl-accent))">
                  {{ 'categories.view_products' | t }}
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>