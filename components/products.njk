<section
  id="{{ componentId }}"
  class="component section"
  data-component-id="{{ componentId }}"
  x-data="{
    searchTerm: '',
    shouldShowItem(el) {
      return this.searchTerm === '' || decodeHtmlEntities(el.dataset.name.toLowerCase()).includes(this.searchTerm.toLowerCase());
    },
    openGroupModalId: null,
    openGroupModal(id) {
      this.openGroupModalId = id;
      document.body.style.overflow = 'hidden';
    },
    closeGroupModal() {
      this.openGroupModalId = null;
      document.body.style.overflow = 'auto';
    }
  }"
>
  <div class="wrap">
    <div class="section-head {{ 'center' if properties.center_head }}">
      <span class="eyebrow {{ 'eyebrow-centered' if properties.center_head }}">{{ properties.eyebrow if properties.eyebrow else 'products.eyebrow' | t }}</span>
      {% if properties.title %}
        <h2 class="title">{{ properties.title | renderString }}</h2>
      {% endif %}
      {% if properties.subtitle %}
        <p class="sub">{{ properties.subtitle | renderString }}</p>
      {% endif %}
    </div>

    {% if properties.show_searchbar %}
      <div class="mb-8 max-w-xl {{ 'mx-auto' if properties.center_head }}">
        <div class="search-input">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <input
            x-model="searchTerm"
            type="text"
            class="input"
            placeholder="{{ 'products.search_placeholder' | t }}"
            aria-label="{{ 'products.search_placeholder' | t }}"
          />
        </div>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 {{ 'justify-items-center' if properties.centered }}">
      {% if properties.ids|length == 0 %}
        {% for item in sortedItems %}
          {% if item.type == 'group' or not item.group_id %}
            <div
              x-show="shouldShowItem($el)"
              x-transition
              data-name="{{ item.name | lower | escape }}"
              class="w-full"
            >
              {% render_snippet "product-card.njk", product=item %}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for item in helpers.components.products.getItemsByIds(sortedItems, properties.ids) %}
          <div
            x-show="shouldShowItem($el)"
            x-transition
            data-name="{{ item.name | lower | escape }}"
            class="w-full"
          >
            {% render_snippet "product-card.njk", product=item %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  {% for group in sortedItems %}
    {% if group.type == 'group' %}
      <div x-show="openGroupModalId == '{{ group.id }}'" x-cloak @keydown.escape.window="closeGroupModal()" class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title-{{ group.id }}" role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen px-4 py-8 text-center">
          <div @click="closeGroupModal" x-show="openGroupModalId == '{{ group.id }}'"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="modal-backdrop" aria-hidden="true"
          ></div>

          <div x-show="openGroupModalId == '{{ group.id }}'"
            x-transition:enter="transition ease-out duration-300 transform"
            x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
            x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
            x-transition:leave="transition ease-in duration-200 transform"
            x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
            x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
            class="group-modal-content gcard gcard-glow w-full max-w-[76rem] p-4 text-left md:p-8"
          >
            <div class="flex items-center justify-between gap-4 mb-6">
              <div>
                <p class="eyebrow mb-1">{{ 'products.category_eyebrow' | t }}</p>
                <h3 id="modal-title-{{ group.id }}" class="font-display text-xl font-bold tracking-tight md:text-2xl">
                  {{ group.name }}
                </h3>
              </div>
              <button @click="closeGroupModal" class="icon-btn" aria-label="{{ 'common.close' | t }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {% for product in group.products %}
                {% render_snippet "product-card.njk", product=product %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</section>
<script>
  /* Catalog sync: real SellAuth products -> localStorage cache for
     the cart recommendations marquee. */
  (function () {
    try {
      var catalog = { updatedAt: Date.now(), items: [], groups: [] };
      var seen = {};
      {% for item in sortedItems %}
        {% if item.type == 'group' %}
          catalog.groups.push({ id: {{ item.id }}, name: {{ item.name | json }} });
          {% for pr in item.products %}
            if (!seen[{{ pr.id }}]) { seen[{{ pr.id }}] = 1; catalog.items.push({ id: {{ pr.id }}, name: {{ pr.name | json }}, path: {{ pr.path | json }}, price: {{ pr.min_price | default(0) }}, currency: {{ pr.currency | json }}, image: {{ (pr.image_url or '') | json }}, stock: {{ pr.stock | default(0) }}, groupId: {{ item.id }} }); }
          {% endfor %}
        {% else %}
          if (!seen[{{ item.id }}]) { seen[{{ item.id }}] = 1; catalog.items.push({ id: {{ item.id }}, name: {{ item.name | json }}, path: {{ item.path | json }}, price: {{ item.min_price | default(0) }}, currency: {{ item.currency | json }}, image: {{ (item.image_url or '') | json }}, stock: {{ item.stock | default(0) }}, groupId: null }); }
        {% endif %}
      {% endfor %}
      localStorage.setItem('sf_catalog', JSON.stringify(catalog));
    } catch (e) {}
  })();
</script>