{% set statusColorMap = {
  'active': 'bg-green-500/20 text-green-500 border-green-500/10',
  'trialing': 'bg-blue-500/20 text-blue-500 border-blue-500/10',
  'past_due': 'bg-yellow-500/20 text-yellow-500 border-yellow-500/10',
  'cancelled': 'bg-zinc-500/20 text-zinc-400 border-zinc-500/10',
  'expired': 'bg-red-500/20 text-red-500 border-red-500/10'
} %}

<div class="container mx-auto" x-data="customerSubscriptions">
  <div class="relative px-4 lg:px-0 py-6 lg:py-8">
    <div class="w-full mx-auto flex flex-col gap-4 md:gap-6 lg:gap-8 lg:flex-row">
      <div class="lg:flex-1">
        {% render_snippet "customer-sidebar.njk" %}
      </div>
      <div class="lg:w-3/4">
        <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
          <h3 class="text-base text-t-primary/80">
            {{ 'subscription.plural' | t }}
          </h3>

          <div x-cloak x-show="error" class="mt-4 bg-red-500/20 border border-red-500/10 text-red-500 text-sm p-3 rounded-lg">
            <span x-text="error"></span>
          </div>

          <div class="mt-4 rounded-lg overflow-x-auto">
            {% if subscriptions.length > 0 %}
              <table class="w-full text-left text-sm text-t-primary/80">
                <thead class="text-xs text-t-primary/60 uppercase bg-white/5">
                  <tr>
                    <th scope="col" class="px-6 py-3">{{ 'common.product' | t }}</th>
                    <th scope="col" class="px-6 py-3">{{ 'common.status' | t }}</th>
                    <th scope="col" class="px-6 py-3">{{ 'common.billing' | t }}</th>
                    <th scope="col" class="px-6 py-3">{{ 'subscription.renews' | t }}</th>
                    <th scope="col" class="px-6 py-3">{{ 'common.action' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for subscription in subscriptions %}
                    <tr class="border-b border-white/5" x-show="!hidden.includes({{ subscription.id }})">
                      <td class="px-6 py-4">
                        {{ subscription.product_name or 'Deleted Product' }}
                        {% if subscription.variant_name %}
                          <span class="text-t-primary/60">({{ subscription.variant_name }})</span>
                        {% endif %}
                      </td>
                      <td class="px-6 py-4 capitalize">
                        <span class="inline-block px-2 py-0.5 rounded border text-xs {{ statusColorMap[subscription.status] or 'bg-zinc-500/20 text-zinc-400 border-zinc-500/10' }}"
                              x-text="labels[{{ subscription.id }}] || '{{ subscription.status | replace('_', ' ') }}'">
                          {{ subscription.status | replace('_', ' ') }}
                        </span>
                        {% if subscription.cancel_at_period_end and subscription.status != 'cancelled' and subscription.status != 'expired' %}
                          <br>
                          <span class="text-[10px] leading-none text-t-primary/60" x-show="!uncancelled.includes({{ subscription.id }})">
                            Ends {{ subscription.current_period_end | formatDateTime }}
                          </span>
                        {% endif %}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        {{ formatPrice(subscription.recurring_price, subscription.currency) }}
                        <span class="text-t-primary/60">{{ subscription.interval_label }}</span>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        {% if subscription.current_period_end %}
                          {{ subscription.current_period_end | formatDateTime }}
                        {% else %}
                          —
                        {% endif %}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        {% if subscription.renewal_url %}
                          <a href="{{ subscription.renewal_url }}" target="_blank" class="text-accent-500 hover:underline mr-3">
                            {{ 'subscription.pay_renewal' | t }}
                          </a>
                        {% endif %}
                        {% if subscription.status in ['active', 'trialing', 'past_due'] %}
                          {% if subscription.cancel_at_period_end %}
                            {% if subscription.can_uncancel %}
                              <button type="button" x-on:click="uncancel({{ subscription.id }})" class="text-accent-500 hover:underline" :disabled="busy">
                                {{ 'common.resume' | t }}
                              </button>
                            {% endif %}
                          {% else %}
                            <button type="button" x-on:click="cancel({{ subscription.id }})" class="text-red-500 hover:underline" :disabled="busy">
                              {{ 'common.cancel' | t }}
                            </button>
                          {% endif %}
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% else %}
              <p class="text-sm text-t-primary/60">
                {{ 'subscription.none' | t }}
              </p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="components">
  {% for componentId in components_order %}
    {% render_component componentId %}
  {% endfor %}
</div>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('customerSubscriptions', () => ({
      busy: false,
      error: null,
      labels: {},
      hidden: [],
      uncancelled: [],

      async request(subscriptionId, action) {
        if (this.busy) return null;
        this.busy = true;
        this.error = null;

        const token = Cookies.get('shop_customer_token');

        try {
          const response = await fetch(`{{ '/v1/customer-dashboard/subscriptions/' | apiInternalUrl }}` + subscriptionId + '/' + action, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.message || {{ ('common.something_went_wrong' | t) | json }});
          }

          return data;
        } catch (error) {
          this.error = error.message;
          return null;
        } finally {
          this.busy = false;
        }
      },

      async cancel(subscriptionId) {
        if (!confirm({{ ('subscription.cancel_confirm' | t) | json }})) {
          return;
        }

        const data = await this.request(subscriptionId, 'cancel');

        if (data) {
          window.location.reload();
        }
      },

      async uncancel(subscriptionId) {
        const data = await this.request(subscriptionId, 'uncancel');

        if (data) {
          window.location.reload();
        }
      },
    }));
  });
</script>
