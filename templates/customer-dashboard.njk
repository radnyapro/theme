{% set discordSecurityEnabled = shop_customer.discord_linked or (shop.discord_login_enabled and not isBuilder) %}
<div class="container mx-auto">
  <div class="relative px-4 lg:px-0 py-6 lg:py-8">
    <div class="w-full mx-auto flex flex-col gap-4 md:gap-6 lg:gap-8 lg:flex-row">
      <div class="lg:flex-1">
        {% render_snippet "customer-sidebar.njk" %}
      </div>
      <div class="lg:w-3/4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
            <h3 class="text-base text-t-primary/80">
              {{ 'customer.completed_orders' | t }}
            </h3>
            <p class="text-2xl text-t-primary font-semibold mt-2">
              {{ shop_customer.total_completed }}
            </p>
          </div>
          <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
            <h3 class="text-base text-t-primary/80">
              {{ 'customer.total_spent' | t }}
            </h3>
            <p class="text-2xl text-t-primary font-semibold mt-2">
              <span x-text="appCurrency.format({{ shop_customer.total_spent_usd }}, 'USD')">
                {{ formatPrice(shop_customer.total_spent_usd, 'USD') }}
              </span>
            </p>
          </div>
          <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
            <h3 class="text-base text-t-primary/80">
              {{ 'customer.customer_since' | t }}
            </h3>
            <p class="text-2xl text-t-primary font-semibold mt-2">
              {{ shop_customer.created_at | formatDate }}
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
          <div class="flex flex-col md:col-span-2 p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
            <h3 class="text-base text-t-primary/80">
              {{ 'customer.latest_order' | t }}
            </h3>
            {% if latest_invoice %}
              <div class="mt-2">
                <p class="text-2xl text-t-primary font-semibold truncate">
                  {% if latest_invoice.items %}
                    {% if latest_invoice.items[0].custom_name %}
                      {{ latest_invoice.items[0].custom_name }}
                    {% else %}
                      {{ latest_invoice.items[0].product.name }}
                      {% if latest_invoice.items[0].variant and latest_invoice.items[0].product.name != latest_invoice.items[0].variant.name %}
                        ({{ latest_invoice.items[0].variant.name }})
                      {% endif %}
                    {% endif %}

                    {% if latest_invoice.items.length > 1 %}
                      & {{ latest_invoice.items.length - 1 }} more
                    {% endif %}
                  {% else %}
                    {{ 'feedback.deleted_product' | t }}
                  {% endif %}
                </p>
                <p class="mt-2 text-sm text-t-primary/60">
                  <a href="{{ latest_invoice.url }}" target="_blank">
                    Invoice <span class="text-accent-500 hover:text-accent-600">#{{ latest_invoice.unique_id }}</span>
                  </a>
                   - {{ latest_invoice.created_at | formatDate }}
                </p>
              </div>
            {% else %}
              <p class="text-2xl text-t-primary font-semibold mt-2">
                {{ 'common.none' | t }}
              </p>
            {% endif %}
          </div>
          {% if shop.customer_balance_enabled %}
            <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
              <h3 class="text-base text-t-primary/80">
                {{ 'common.balance' | t }}
              </h3>
              <div class="mt-2">
                <p class="text-2xl text-t-primary font-semibold">
                  <span x-text="appCurrency.format({{ shop_customer.balance }}, 'USD')">
                    {{ formatPrice(shop_customer.balance, 'USD') }}
                  </span>
                </p>
                <p class="mt-2 text-sm text-t-primary/60">
                  <a href="{{ '/customer/balance' | shopUrl }}">
                    <span class="text-accent-500 hover:text-accent-600">{{ 'balance.top_up' | t }}</span>
                  </a>
                </p>
              </div>
            </div>
          {% endif %}
        </div>
        <div class="grid grid-cols-1 {{ 'md:grid-cols-3' if discordSecurityEnabled else 'md:grid-cols-2' }} gap-4 mt-4">
          <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
            <h3 class="text-base text-t-primary/80">
              {{ 'common.password' | t }}
            </h3>
            <p class="text-sm text-t-primary/60 mt-1">
              {{ ('customer.password_set_hint' if shop_customer.has_password else 'customer.password_unset_hint') | t }}
            </p>
            <div class="mt-auto pt-4">
              <button
                type="button"
                class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50 disabled:opacity-50 disabled:pointer-events-none"
                @click="appSecurity.openPasswordModal()"
              >
                {{ ('customer.change_password' if shop_customer.has_password else 'customer.set_password') | t }}
              </button>
            </div>
          </div>
          <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
            <h3 class="text-base text-t-primary/80">
              {{ 'login.two_factor' | t }}
            </h3>
            <p class="text-sm text-t-primary/60 mt-1">
              {{ ('customer.tfa_on_hint' if shop_customer.tfa_enabled else 'customer.2fa_hint') | t | safe }}
            </p>
            <div class="mt-auto pt-4">
              <button
                type="button"
                class="px-4 py-2 rounded-lg text-sm font-semibold {{ 'border border-red-500 text-red-500 transition hover:bg-red-500/10' if shop_customer.tfa_enabled else 'bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50' }} disabled:opacity-50 disabled:pointer-events-none"
                @click="appSecurity.openTfaModal()"
              >
                {{ ('customer.disable_2fa' if shop_customer.tfa_enabled else 'customer.enable_2fa') | t }}
              </button>
            </div>
          </div>
          {% if discordSecurityEnabled %}
            <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
              <h3 class="text-base text-t-primary/80">
                {{ 'customer.discord' | t }}
              </h3>
              <p class="text-sm text-t-primary/60 mt-1 break-words">
                {% if shop_customer.discord_linked %}
                  {{ 'customer.discord_connected_hint' | t({ username: shop_customer.discord_username }) }}
                {% else %}
                  {{ 'customer.discord_unconnected_hint' | t }}
                {% endif %}
              </p>
              <div class="mt-auto pt-4">
                <button
                  type="button"
                  class="px-4 py-2 rounded-lg text-sm font-semibold {{ 'border border-red-500 text-red-500 transition hover:bg-red-500/10' if shop_customer.discord_linked else 'bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50' }} disabled:opacity-50 disabled:pointer-events-none"
                  @click="appSecurity.openDiscordModal()"
                >
                  {{ ('customer.disconnect_discord' if shop_customer.discord_linked else 'customer.connect_discord') | t }}
                </button>
              </div>
            </div>
          {% endif %}
        </div>
        <div class="mt-4 flex justify-end gap-4">
          {% if shop_customer.has_multiple_sessions %}
            <button
              type="button"
              @click="appCustomer.logoutOtherSessions()"
              class="px-6 py-2 rounded-lg inline-flex justify-center items-center gap-3 border text-sm font-semibold bg-transparent border-white/5 text-t-primary hover:bg-white/10 transition-colors duration-300 ease-in-out"
            >
              <span>{{ 'customer.logout_other_devices' | t }}</span>
              <template x-if="!appCustomer.loggingOutOtherSessions">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M5 21q-.825 0-1.412-.587T3 19v-4h2v4h14V5H5v4H3V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zm5.5-4l-1.4-1.45L11.65 13H3v-2h8.65L9.1 8.45L10.5 7l5 5z"/></svg>
              </template>
              <template x-if="appCustomer.loggingOutOtherSessions">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-dasharray="16" stroke-dashoffset="16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c4.97 0 9 4.03 9 9"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.2s" values="16;0"/><animateTransform attributeName="transform" dur="1.5s" repeatCount="indefinite" type="rotate" values="0 12 12;360 12 12"/></path></svg>
              </template>
            </button>
          {% endif %}
          <button
            type="button"
            @click="appCustomer.openDeleteModal()"
            class="px-6 py-2 rounded-lg inline-flex justify-center items-center gap-3 border text-sm font-semibold bg-transparent border-red-500 text-red-500 hover:bg-red-500/10 transition-colors duration-300 ease-in-out"
          >
            <span>{{ 'customer.delete_account' | t }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M7 21q-.825 0-1.412-.587T5 19V6q-.425 0-.712-.288T4 5t.288-.712T5 4h4q0-.425.288-.712T10 3h4q.425 0 .713.288T15 4h4q.425 0 .713.288T20 5t-.288.713T19 6v13q0 .825-.587 1.413T17 21zm3-4q.425 0 .713-.288T11 16V9q0-.425-.288-.712T10 8t-.712.288T9 9v7q0 .425.288.713T10 17m4 0q.425 0 .713-.288T15 16V9q0-.425-.288-.712T14 8t-.712.288T13 9v7q0 .425.288.713T14 17"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div
  x-show="appSecurity.passwordModalIsOpen"
  x-cloak
  class="fixed inset-0 z-50 overflow-y-auto sa-customer-password-modal"
  aria-labelledby="password-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div
      x-show="appSecurity.passwordModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appSecurity.closePasswordModal()"
      class="fixed inset-0 transition-opacity bg-black/80"
      aria-hidden="true"
    ></div>
    <div
      x-show="appSecurity.passwordModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform border-2 border-white/5 rounded-xl bg-background text-t-primary"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 id="password-modal-title" class="text-xl font-bold truncate">
          {{ 'Change Password' if shop_customer.has_password else 'Set Password' }}
        </h3>
        <button @click="appSecurity.closePasswordModal()" class="text-t-primary focus:outline-none hover:text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275-.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"/></svg>
        </button>
      </div>
      <form class="flex flex-col gap-2" x-show="!appSecurity.passwordSuccess" @submit.prevent="appSecurity.savePassword({{ 'true' if shop_customer.has_password else 'false' }})">
        {% if shop_customer.has_password %}
          <input type="password" autocomplete="current-password" placeholder="{{ 'customer.current_password' | t }}" x-model="appSecurity.currentPassword" class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none">
        {% endif %}
        <input type="password" autocomplete="new-password" placeholder="{{ 'customer.new_password_placeholder' | t }}" x-model="appSecurity.password" class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none">
        {% if shop_customer.tfa_enabled %}
          <input type="text" maxlength="8" inputmode="numeric" autocomplete="one-time-code" placeholder="{{ 'login.authenticator_code' | t }}" x-model="appSecurity.tfaCodeForPassword" class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none">
        {% endif %}
        <div class="flex items-center gap-2">
          <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50 disabled:opacity-50 disabled:pointer-events-none" :disabled="appSecurity.passwordLoading">
            {{ 'Change Password' if shop_customer.has_password else 'Set Password' }}
          </button>
          {% if shop_customer.has_password %}
            <button type="button" class="px-4 py-2 rounded-lg text-sm font-semibold border border-red-500 text-red-500 transition hover:bg-red-500/10 disabled:opacity-50 disabled:pointer-events-none" x-show="!appSecurity.passwordRemoveConfirm" @click="appSecurity.startRemovePassword()" :disabled="appSecurity.passwordLoading">
              {{ 'common.remove' | t }}
            </button>
          {% endif %}
        </div>
        {% if shop_customer.has_password %}
          <div class="flex flex-wrap items-center justify-between gap-3" x-show="appSecurity.passwordRemoveConfirm" x-cloak>
            <p class="text-sm text-t-primary min-w-0">{{ "customer.remove_password_confirm" | t }}</p>
            <div class="flex items-center gap-2 shrink-0">
              <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-white/10 text-t-primary/60 transition hover:text-t-primary hover:bg-white/5 disabled:opacity-50 disabled:pointer-events-none" @click="appSecurity.passwordRemoveConfirm = false" :disabled="appSecurity.passwordLoading">{{ 'common.cancel' | t }}</button>
              <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-500 text-red-500 transition hover:bg-red-500/10 disabled:opacity-50 disabled:pointer-events-none" @click="appSecurity.removePassword()" :disabled="appSecurity.passwordLoading">{{ 'common.remove' | t }}</button>
            </div>
          </div>
        {% endif %}
        <p class="text-sm text-red-400" x-show="appSecurity.passwordError" x-text="appSecurity.passwordError"></p>
      </form>
      <div class="flex flex-col gap-2" x-show="appSecurity.passwordSuccess" x-cloak>
        <p class="text-sm text-green-500" x-text="appSecurity.passwordSuccess"></p>
        <button type="button" class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50 disabled:opacity-50 disabled:pointer-events-none" @click="appSecurity.closePasswordModal()">{{ 'common.done' | t }}</button>
      </div>
    </div>
  </div>
</div>

<div
  x-show="appSecurity.tfaModalIsOpen"
  x-cloak
  class="fixed inset-0 z-50 overflow-y-auto sa-customer-tfa-modal"
  aria-labelledby="tfa-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div
      x-show="appSecurity.tfaModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appSecurity.closeTfaModal()"
      class="fixed inset-0 transition-opacity bg-black/80"
      aria-hidden="true"
    ></div>
    <div
      x-show="appSecurity.tfaModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform border-2 border-white/5 rounded-xl bg-background text-t-primary"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 id="tfa-modal-title" class="text-xl font-bold truncate">
          {{ 'login.two_factor' | t }}
        </h3>
        <button @click="appSecurity.closeTfaModal()" class="text-t-primary focus:outline-none hover:text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275-.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"/></svg>
        </button>
      </div>
      {% if shop_customer.tfa_enabled %}
        <p class="text-sm text-t-primary/60 mt-1">
          2FA is <span class="text-green-500 font-semibold">enabled</span>. Enter a code from your authenticator app to disable it.
        </p>
        <form class="mt-4 flex flex-col gap-2" @submit.prevent="appSecurity.tfaDisable()">
          <input type="text" maxlength="8" autocomplete="one-time-code" placeholder="{{ 'customer.recovery_code_placeholder' | t }}" x-model="appSecurity.tfaCode" class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none">
          <div>
            <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold border border-red-500 text-red-500 transition hover:bg-red-500/10 disabled:opacity-50 disabled:pointer-events-none" :disabled="appSecurity.tfaLoading">
              {{ 'customer.disable_2fa' | t }}
            </button>
          </div>
          <p class="text-sm text-red-400" x-show="appSecurity.tfaError" x-text="appSecurity.tfaError"></p>
        </form>
      {% else %}
        <p class="text-sm text-t-primary/60 mt-1">
          {{ 'customer.2fa_hint' | t }}
        </p>
        <div class="mt-4 flex flex-col gap-2">
          <template x-if="appSecurity.tfaRecoveryCodes">
            <div x-data="{ codesCopied: false }">
              <p class="text-sm text-green-500 font-semibold">{{ 'customer.tfa_enabled_notice' | t }}</p>
              <code class="block mt-2 p-2 text-xs text-t-primary bg-white/5 border border-white/5 rounded-lg whitespace-pre-wrap" x-text="appSecurity.tfaRecoveryCodes.join('\n')"></code>
              <div class="grid grid-cols-2 gap-2 mt-2">
                <button
                  type="button"
                  @click="navigator.clipboard.writeText(appSecurity.tfaRecoveryCodes.join('\n')).then(() => { codesCopied = true; setTimeout(() => codesCopied = false, 2000) })"
                  class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-white/10 text-t-primary/60 transition hover:text-t-primary hover:bg-white/5 disabled:opacity-50 disabled:pointer-events-none"
                >
                  <span x-text="codesCopied ? '{{ 'common.copied_short' | t | jsEscape }}' : '{{ 'common.copy' | t | jsEscape }}'"></span>
                </button>
                <button
                  type="button"
                  @click="Object.assign(document.createElement('a'), { href: 'data:text/plain;charset=utf-8,' + encodeURIComponent(appSecurity.tfaRecoveryCodes.join('\n')), download: 'recovery-codes.txt' }).click()"
                  class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-white/10 text-t-primary/60 transition hover:text-t-primary hover:bg-white/5 disabled:opacity-50 disabled:pointer-events-none"
                >
                  {{ 'common.download' | t }}
                </button>
              </div>
            </div>
          </template>
          <template x-if="!appSecurity.tfaRecoveryCodes && !appSecurity.tfaSecret">
            <div>
              <button
                type="button"
                class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50 disabled:opacity-50 disabled:pointer-events-none"
                @click="appSecurity.tfaGetSecret()"
                :disabled="appSecurity.tfaLoading"
              >
                {{ 'customer.enable_2fa' | t }}
              </button>
            </div>
          </template>
          <template x-if="appSecurity.tfaSecret">
            <form class="flex flex-col gap-2" @submit.prevent="appSecurity.tfaEnable()">
              <p class="text-sm text-t-primary/60">{{ 'customer.tfa_scan_hint' | t }}</p>
              <img :src="appSecurity.tfaQrCode" alt="{{ 'customer.tfa_qr_alt' | t }}" class="size-40 rounded-lg bg-white p-2">
              <p class="text-xs text-t-primary/60">{{ 'customer.tfa_secret_manual' | t }} <code class="text-t-primary" x-text="appSecurity.tfaSecret"></code></p>
              <input type="text" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="{{ 'customer.tfa_code_placeholder' | t }}" x-model="appSecurity.tfaCode" x-init="$nextTick(() => $el.focus())" class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none">
              <div>
                <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50 disabled:opacity-50 disabled:pointer-events-none" :disabled="appSecurity.tfaLoading">
                  {{ 'customer.confirm_enable' | t }}
                </button>
              </div>
            </form>
          </template>
          <p class="text-sm text-red-400" x-show="appSecurity.tfaError" x-text="appSecurity.tfaError"></p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% if discordSecurityEnabled %}
<div
  x-show="appSecurity.discordModalIsOpen"
  x-cloak
  class="fixed inset-0 z-50 overflow-y-auto sa-customer-discord-modal"
  aria-labelledby="discord-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div
      x-show="appSecurity.discordModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appSecurity.closeDiscordModal()"
      class="fixed inset-0 transition-opacity bg-black/80"
      aria-hidden="true"
    ></div>
    <div
      x-show="appSecurity.discordModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform border-2 border-white/5 rounded-xl bg-background text-t-primary"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 id="discord-modal-title" class="text-xl font-bold truncate">
          {{ 'customer.discord' | t }}
        </h3>
        <button @click="appSecurity.closeDiscordModal()" class="text-t-primary focus:outline-none hover:text-accent" aria-label="{{ 'common.close' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275-.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"/></svg>
        </button>
      </div>
      <p class="text-sm text-t-primary/60 mt-1">
        {% if shop_customer.discord_linked %}
          {{ 'customer.discord_connected_hint' | t({ username: shop_customer.discord_username }) }}
        {% else %}
          {{ 'customer.discord_unconnected_hint' | t }}
        {% endif %}
      </p>
      <form class="mt-4 flex flex-col gap-2" x-show="!appSecurity.discordSuccess" @submit.prevent="{{ 'appSecurity.disconnectDiscord()' if shop_customer.discord_linked else 'appSecurity.connectDiscord()' }}">
        {% if shop_customer.has_password %}
          <input type="password" autocomplete="current-password" placeholder="{{ 'customer.current_password' | t }}" x-model="appSecurity.discordCurrentPassword" class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none">
        {% endif %}
        {% if shop_customer.tfa_enabled %}
          <input type="text" maxlength="8" inputmode="numeric" autocomplete="one-time-code" placeholder="{{ 'login.authenticator_code' | t }}" x-model="appSecurity.discordTfaCode" class="w-full px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none">
        {% endif %}
        {% if shop_customer.discord_linked %}
          <p class="text-sm text-t-primary/60">{{ 'customer.disconnect_discord_hint' | t }}</p>
        {% endif %}
        <div>
          <button
            type="submit"
            class="px-4 py-2 rounded-lg inline-flex items-center gap-2 text-sm font-semibold {{ 'border border-red-500 text-red-500 transition hover:bg-red-500/10' if shop_customer.discord_linked else 'bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50' }} disabled:opacity-50 disabled:pointer-events-none"
            :disabled="appSecurity.discordLoading"
          >
            <span>{{ ('customer.disconnect_discord' if shop_customer.discord_linked else 'customer.connect_discord') | t }}</span>
            <template x-if="appSecurity.discordLoading">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>
            </template>
          </button>
        </div>
        <p class="text-sm text-red-400" x-show="appSecurity.discordError === 'blocked'" x-cloak>{{ 'login.discord_popup_blocked' | t }}</p>
        <p class="text-sm text-red-400" x-show="appSecurity.discordError === 'failed'" x-cloak>{{ 'login.discord_failed' | t }}</p>
        <p class="text-sm text-red-400" x-show="appSecurity.discordError && appSecurity.discordError !== 'blocked' && appSecurity.discordError !== 'failed'" x-cloak x-text="appSecurity.discordError"></p>
      </form>
      <div class="mt-4 flex flex-col gap-2" x-show="appSecurity.discordSuccess" x-cloak>
        <p class="text-sm text-green-500" x-text="appSecurity.discordSuccess"></p>
      </div>
    </div>
  </div>
</div>
{% endif %}

<div
  x-show="appCustomer.deleteModalIsOpen"
  x-cloak
  class="fixed inset-0 z-50 overflow-y-auto"
  aria-labelledby="delete-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div
      x-show="appCustomer.deleteModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appCustomer.closeDeleteModal()"
      class="fixed inset-0 transition-opacity bg-black/80"
      aria-hidden="true"
    ></div>
    <div
      x-show="appCustomer.deleteModalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform border-2 border-white/5 rounded-xl bg-background text-t-primary"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 id="delete-modal-title" class="text-xl font-bold truncate">
          {{ 'customer.delete_account_title' | t }}
        </h3>
        <button @click="appCustomer.closeDeleteModal()" class="text-t-primary focus:outline-none hover:text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275-.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"/></svg>
        </button>
      </div>
      <p class="text-sm text-t-primary/80 mb-6">
        {{ 'customer.delete_account_warning' | t }}
      </p>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-4">
        <button
          type="button"
          @click="appCustomer.closeDeleteModal()"
          class="px-6 py-2 rounded-lg inline-flex justify-center items-center gap-3 text-sm font-semibold text-accent-500 border border-accent-500 bg-transparent hover:bg-accent-500/10 transition-colors duration-300 ease-in-out"
        >
          <span>{{ 'common.cancel' | t }}</span>
          <i class="fa fa-times"></i>
        </button>
        <button
          type="button"
          @click="appCustomer.deleteAccount()"
          class="px-6 py-2 rounded-lg inline-flex justify-center items-center gap-3 text-sm font-semibold border border-red-500 bg-red-500 hover:enabled:bg-red-600 transition-colors duration-300 ease-in-out disabled:opacity-50 disabled:pointer-events-none"
          :disabled="appCustomer.deleteModalLoading"
        >
          <span>{{ 'customer.delete_account' | t }}</span>
          <template x-if="!appCustomer.deleteModalLoading">
            <i class="fa fa-trash"></i>
          </template>
          <template x-if="appCustomer.deleteModalLoading">
            <i class="fa fa-circle-notch animate-spin"></i>
          </template>
        </button>
      </div>
    </div>
  </div>
</div>

<div class="components">
  {% for componentId in components_order %}
    {% render_component componentId %}
  {% endfor %}
</div>