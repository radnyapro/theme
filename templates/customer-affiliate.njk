<div class="container mx-auto">
  <div class="relative px-4 lg:px-0 py-6 lg:py-8">
    <div class="w-full mx-auto flex flex-col gap-4 md:gap-6 lg:gap-8 lg:flex-row">
      <div class="lg:flex-1">
        {% render_snippet "customer-sidebar.njk" %}
      </div>
      <div class="lg:w-3/4">
        {% if shop_customer.affiliate_code %}
          {% if affiliate_suspended %}
            <div class="flex flex-col p-3 md:p-4 lg:p-5 mb-4 bg-card border border-white/5 rounded-lg">
              <h3 class="text-base text-t-primary/80">
                {{ 'affiliate.suspended_title' | t }}
              </h3>
              <p class="text-sm text-t-primary/60 mt-2">
                {{ 'affiliate.suspended_body' | t }}
              </p>
            </div>
          {% endif %}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% if not affiliate_suspended %}
            <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
              <h3 class="text-base text-t-primary/80">
                {{ 'affiliate.your_link' | t }}
              </h3>
              <p class="text-sm text-t-primary/60 mt-1">
                {{ 'affiliate.share_hint' | t }}
              </p>
              <div class="flex justify-between items-center gap-4 mt-4">
                <button
                  type="button"
                  x-data="{
                    copied: false,
                    copy() {
                      navigator.clipboard.writeText('{{ shop.url }}/?a={{ shop_customer.affiliate_code }}').then(() => {
                        this.copied = true;
                        setTimeout(() => { this.copied = false; }, 2000);
                      });
                    }
                  }"
                  @click="copy()"
                  :title="copied ? '{{ 'common.copied' | t | jsEscape }}' : '{{ 'common.click_to_copy' | t | jsEscape }}'"
                  class="group flex items-center gap-2 min-w-0 text-left text-t-primary transition hover:text-accent-500"
                >
                  <span class="truncate">{{ shop.url }}/?a={{ shop_customer.affiliate_code }}</span>
                  <svg x-show="!copied" class="size-4 shrink-0 opacity-40 transition group-hover:opacity-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><!-- Icon from Tabler Icons by Paweł Kuna - https://github.com/tabler/tabler-icons/blob/master/LICENSE --><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M7 9.667A2.667 2.667 0 0 1 9.667 7h8.666A2.667 2.667 0 0 1 21 9.667v8.666A2.667 2.667 0 0 1 18.333 21H9.667A2.667 2.667 0 0 1 7 18.333z"/><path d="M4.012 16.737A2 2 0 0 1 3 15V5c0-1.1.9-2 2-2h10c.75 0 1.158.385 1.5 1"/></g></svg>
                  <svg x-show="copied" x-cloak class="size-4 shrink-0 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><!-- Icon from Tabler Icons by Paweł Kuna - https://github.com/tabler/tabler-icons/blob/master/LICENSE --><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12l5 5l10 -10"/></g></svg>
                </button>
                {% if shop.settings.affiliate.code_editable %}
                  <button
                    type="button"
                    class="shrink-0 text-t-primary transition hover:opacity-75"
                    title="{{ 'affiliate.edit_code' | t }}"
                    @click="appAffiliate.modalEditCodeOpen('{{ shop_customer.affiliate_code }}')"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h8.925l-2 2H5v14h14v-6.95l2-2V19q0 .825-.587 1.413T19 21zm4-6v-4.25l9.175-9.175q.3-.3.675-.45t.75-.15q.4 0 .763.15t.662.45L22.425 3q.275.3.425.663T23 4.4t-.137.738t-.438.662L13.25 15zM21.025 4.4l-1.4-1.4zM11 13h1.4l5.8-5.8l-.7-.7l-.725-.7L11 11.575zm6.5-6.5l-.725-.7zl.7.7z"/></svg>
                  </button>
                {% endif %}
              </div>
            </div>
            <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
              <h3 class="text-base text-t-primary/80">
                {{ 'customer.your_tier' | t }}{% if affiliate_tier %}: {{ affiliate_tier.name }}{% endif %}
              </h3>
              <p class="text-sm text-t-primary/60 mt-1">
                {{ 'affiliate.program_hint' | t }}
              </p>
              {% if affiliate_tier %}
                <div class="flex items-center gap-6 mt-4">
                  <div>
                    <p class="text-xs text-t-primary/60 uppercase">{{ 'common.commission' | t }}</p>
                    <p class="text-base text-t-primary font-semibold">{{ affiliate_tier.percentage }}%</p>
                  </div>
                  {% if affiliate_tier.discount_percentage > 0 %}
                    <div>
                      <p class="text-xs text-t-primary/60 uppercase">{{ 'affiliate.buyer_discount' | t }}</p>
                      <p class="text-base text-t-primary font-semibold">{{ affiliate_tier.discount_percentage }}%</p>
                    </div>
                  {% endif %}
                  <div>
                    <p class="text-xs text-t-primary/60 uppercase">{{ 'affiliate.lifetime_earned' | t }}</p>
                    <p class="text-base text-t-primary font-semibold" x-text="appCurrency.format({{ lifetime_earnings }}, 'USD')">
                      {{ formatPrice(lifetime_earnings, 'USD') }}
                    </p>
                  </div>
                </div>
              {% else %}
                <p class="mt-4 text-sm text-t-primary/60">{{ 'affiliate.no_tier' | t }}</p>
              {% endif %}
            </div>
            {% endif %}

            {% if shop.settings.affiliate.balance_mode == 'separate' %}
              <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg md:col-span-2">
                <div class="flex items-center justify-between">
                  <h3 class="text-base text-t-primary/80">
                    {{ 'affiliate.balance' | t }}
                  </h3>
                  <span class="text-lg text-t-primary font-semibold" x-text="appCurrency.format({{ shop_customer.affiliate_balance }}, 'USD')">
                    {{ formatPrice(shop_customer.affiliate_balance, 'USD') }}
                  </span>
                </div>
                <p class="text-sm text-t-primary/60 mt-1">
                  {{ 'affiliate.commissions_separate' | t }}
                </p>

                {% if shop.settings.affiliate.transfer_enabled and shop_customer.affiliate_balance > 0 and not affiliate_suspended %}
                  <div class="mt-4 pt-4 border-t border-white/5">
                    <h4 class="text-sm text-t-primary/80">{{ 'affiliate.transfer_to_store_balance' | t }}</h4>
                    <div class="flex items-center gap-2 mt-2">
                      <input
                        type="number"
                        min="0.01"
                        step="0.01"
                        placeholder="{{ 'affiliate.amount_usd_placeholder' | t }}"
                        class="w-40 px-3 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-t-primary focus:outline-none"
                        x-model="appAffiliate.transferAmount"
                      >
                      <button
                        type="button"
                        class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50 disabled:opacity-50 disabled:pointer-events-none"
                        @click="appAffiliate.submitTransfer()"
                        :disabled="appAffiliate.transferLoading"
                      >
                        {{ 'common.transfer' | t }}
                      </button>
                    </div>
                    <p class="text-sm text-red-400 mt-2" x-show="appAffiliate.transferError" x-text="appAffiliate.transferError"></p>
                  </div>
                {% endif %}

                {% if shop.settings.affiliate.payouts_enabled and not affiliate_suspended %}
                  <div class="mt-4 pt-4 border-t border-white/5">
                    {% if has_pending_payout %}
                      <p class="text-sm text-t-primary/60">
                        {{ 'affiliate.pending_payout' | t }}
                      </p>
                    {% else %}
                      <button
                        type="button"
                        class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent-500 border border-accent-500 text-t-accent transition hover:enabled:bg-accent-500/50 disabled:opacity-50 disabled:pointer-events-none"
                        @click="appAffiliate.modalPayoutOpen()"
                      >
                        {{ 'affiliate.request_payout_title' | t }}
                      </button>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              {% if payout_requests.length > 0 %}
                <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg md:col-span-2">
                  <h3 class="text-base text-t-primary/80">{{ 'affiliate.payout_requests' | t }}</h3>
                  <div class="mt-4 rounded-lg overflow-x-auto">
                    <table class="w-full text-left text-sm text-t-primary/80">
                      <thead class="text-xs text-t-primary/60 uppercase bg-white/5">
                        <tr>
                          <th scope="col" class="px-6 py-3">{{ 'common.amount' | t }}</th>
                          <th scope="col" class="px-6 py-3">{{ 'common.status' | t }}</th>
                          <th scope="col" class="px-6 py-3">{{ 'common.note' | t }}</th>
                          <th scope="col" class="px-6 py-3">{{ 'affiliate.requested' | t }}</th>
                          <th scope="col" class="px-6 py-3"></th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for payout in payout_requests %}
                          <tr class="border-b border-white/5">
                            <td class="px-6 py-4 whitespace-nowrap">
                              <span x-text="appCurrency.format({{ payout.amount }}, 'USD')">{{ formatPrice(payout.amount, 'USD') }}</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap capitalize">{{ payout.status }}</td>
                            <td class="px-6 py-4">{{ payout.seller_note if payout.seller_note else '-' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">{{ payout.created_at | formatDateTime }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                              {% if payout.status == 'pending' and not affiliate_suspended %}
                                <button
                                  type="button"
                                  class="text-sm text-red-400 transition hover:opacity-75"
                                  @click="appAffiliate.cancelPayout({{ payout.id }})"
                                >
                                  {{ 'common.cancel' | t }}
                                </button>
                              {% endif %}
                            </td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              {% endif %}

              {% if affiliate_wallet_transactions.length > 0 %}
                <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg md:col-span-2">
                  <h3 class="text-base text-t-primary/80">{{ 'affiliate.balance_history' | t }}</h3>
                  <div class="mt-4 rounded-lg overflow-x-auto">
                    <table class="w-full text-left text-sm text-t-primary/80">
                      <thead class="text-xs text-t-primary/60 uppercase bg-white/5">
                        <tr>
                          <th scope="col" class="px-6 py-3">{{ 'common.type' | t }}</th>
                          <th scope="col" class="px-6 py-3">{{ 'common.description' | t }}</th>
                          <th scope="col" class="px-6 py-3">{{ 'common.amount' | t }}</th>
                          <th scope="col" class="px-6 py-3">{{ 'common.date' | t }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for transaction in affiliate_wallet_transactions %}
                          <tr class="border-b border-white/5">
                            <td class="px-6 py-4 whitespace-nowrap capitalize">{{ transaction.type }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">{{ transaction.description if transaction.description else '-' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                              <span x-text="appCurrency.format({{ transaction.amount }}, 'USD')">{{ formatPrice(transaction.amount, 'USD') }}</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">{{ transaction.created_at | formatDateTime }}</td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              {% endif %}
            {% else %}
              <a href="{{ '/customer/balance' | shopUrl }}" class="flex items-center gap-2 justify-between p-3 md:px-4 lg:px-5 bg-card border border-white/5 rounded-lg transition ease-in-out duration-300 hover:bg-white/10 hover:border-white/10">
                <h3 class="text-base text-t-primary/80">
                  {{ 'affiliate.commissions_to_store_balance' | t }}
                </h3>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-t-primary/80" fill="currentColor" viewBox="0 0 256 256"><path d="M224,104a8,8,0,0,1-16,0V59.32l-66.33,66.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z"></path></svg>
              </a>
              <a href="{{ '/customer/balance' | shopUrl }}" class="flex items-center gap-2 justify-between p-3 md:px-4 lg:px-5 bg-card border border-white/5 rounded-lg transition ease-in-out duration-300 hover:bg-white/10 hover:border-white/10">
                <h3 class="text-base text-t-primary/80">
                  {{ 'affiliate.view_balance_history' | t }}
                </h3>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-t-primary/80" fill="currentColor" viewBox="0 0 256 256"><path d="M224,104a8,8,0,0,1-16,0V59.32l-66.33,66.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z"></path></svg>
              </a>
            {% endif %}
          </div>

          {% if public_tiers.length > 1 and not affiliate_suspended %}
            <div class="mt-4">
              <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
                <h3 class="text-base text-t-primary/80">{{ 'affiliate.tiers' | t }}</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-4">
                  {% for tier in public_tiers %}
                    <div class="p-3 bg-white/5 border border-white/5 rounded-lg{% if affiliate_tier and tier.name == affiliate_tier.name %} border-white/20{% endif %}">
                      <p class="text-sm text-t-primary font-semibold">{{ tier.name }}</p>
                      <p class="text-xs text-t-primary/60 mt-1">{{ tier.percentage }}% commission{% if tier.discount_percentage > 0 %} &middot; {{ tier.discount_percentage }}% buyer discount{% endif %}</p>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

          <div class="mt-4">
            <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
              <h3 class="text-base text-t-primary/80">
                {{ 'affiliate.referred_users' | t }}
              </h3>
              <div class="mt-4 rounded-lg overflow-hidden">
                {% if referred_customers.length > 0 %}
                  <table class="w-full text-left text-sm text-t-primary/80">
                    <thead class="text-xs text-t-primary/60 uppercase bg-white/5">
                      <tr>
                        <th scope="col" class="px-6 py-3">{{ 'login.email' | t }}</th>
                        <th scope="col" class="px-6 py-3">{{ 'common.date' | t }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for customer in referred_customers %}
                        <tr class="border-b border-white/5">
                          <td class="px-6 py-4 whitespace-nowrap capitalize">
                            {{ customer.email }}
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap">
                            {{ customer.created_at | formatDateTime }}
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                {% else %}
                  <p class="text-sm text-t-primary/60">
                    {{ 'affiliate.no_referrals' | t }}
                  </p>
                {% endif %}
              </div>
              {% if referred_customers_paginator.last_page > 1 %}
                {% render_snippet "pagination.njk", paginator=referred_customers_paginator %}
              {% endif %}
            </div>
          </div>
        {% else %}
          <div class="flex flex-col p-3 md:p-4 lg:p-5 bg-card border border-white/5 rounded-lg">
            <h3 class="text-base text-t-primary/80">
              {{ 'affiliate.program' | t }}
            </h3>
            <p class="text-sm text-t-primary/60 mt-2">
              {{ 'affiliate.no_code' | t }}
            </p>
            <p class="text-sm text-t-primary/60 mt-1">
              {{ 'affiliate.contact_to_enroll' | t }}
            </p>
            {% if public_tiers.length > 0 %}
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-4">
                {% for tier in public_tiers %}
                  <div class="p-3 bg-white/5 border border-white/5 rounded-lg">
                    <p class="text-sm text-t-primary font-semibold">{{ tier.name }}</p>
                    <p class="text-xs text-t-primary/60 mt-1">{{ tier.percentage }}% commission{% if tier.discount_percentage > 0 %} &middot; {{ tier.discount_percentage }}% buyer discount{% endif %}</p>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="components">
  {% for componentId in components_order %}
    {% render_component componentId %}
  {% endfor %}
</div>

{% render_snippet "affiliate-edit-code-modal.njk" %}

{% if shop.settings.affiliate.balance_mode == 'separate' and shop.settings.affiliate.payouts_enabled %}
  {% render_snippet "affiliate-payout-modal.njk" %}
{% endif %}
