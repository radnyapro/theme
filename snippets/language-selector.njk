{% if languages and languages | length > 1 %}
  <div class="language-selector">
    <select
      data-default-lang="{{ defaultLang }}"
      class="bg-card border border-white/5 rounded-lg text-transparent font-semibold"
      aria-label="{{ 'header.language' | t }}"
      style="width: 92px; height: 38px;"
    >
      {% for language in languages %}
        <option value="{{ language.url if language.url else '' }}" data-code="{{ language.code }}" {{ 'selected' if language.active }}>
          <span class="flex items-center gap-2">
            {% if _lsFlags[language.code] %}
              <svg viewBox="0 0 640 480" class="flag" aria-hidden="true">{{ _lsFlags[language.code] | safe }}</svg>
            {% endif %}
            <span class="text-t-primary code">{{ language.code.toUpperCase() }}</span>
            <span class="text-t-primary name">{{ language.name }}</span>
          </span>
        </option>
      {% endfor %}
    </select>
  </div>
{% endif %}
