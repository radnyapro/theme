{% set isGroup = product.type == 'group' %}
<a class="ab-product-card" href="{{ ('#ab-group-' ~ componentId ~ '-' ~ product.id) if isGroup else (('/product/' ~ product.path) | shopUrl) }}" {% if isGroup %}data-ab-group="ab-group-{{ componentId }}-{{ product.id }}" aria-haspopup="dialog"{% else %}data-ab-product aria-haspopup="dialog"{% endif %}>
  <div class="ab-product-image">
    {% if product.image_urls | length > 0 %}<img src="{{ product.image_urls[0] }}" alt="{{ product.name }}" loading="lazy" width="640" height="360">{% elif product.image_url %}<img src="{{ product.image_url }}" alt="{{ product.name }}" loading="lazy" width="640" height="360">{% else %}<div class="ab-image-placeholder"><i class="fa-solid fa-cube" aria-hidden="true"></i></div>{% endif %}
    {% if properties.show_status != false %}<div class="ab-card-badges">{% for badge in product.product_badges.card %}<span style="--badge-color:{{ badge.color }}">{{ badge.label }}</span>{% endfor %}</div>{% endif %}
    <span class="ab-card-arrow" aria-hidden="true">↗</span>
  </div>
  <div class="ab-product-info"><h3>{{ product.name }}</h3><div class="ab-card-meta">
    {% if isGroup %}<span>{{ product.products | length }} {{ 'product' if product.products | length == 1 else 'products' }}</span>
    {% elif properties.show_stock != false %}<span class="ab-stock"><span class="ab-dot {{ 'ab-dot-empty' if product.stock == 0 }}"></span>{% if product.stock == 0 %}Out of stock{% elif product.stock == -1 or product.hide_stock_count %}In stock{% elif product.stock != null %}{{ product.stock }} in stock{% else %}View availability{% endif %}</span>{% endif %}
    {% if properties.show_price != false and product.min_price != null %}<span class="ab-price">{% if isGroup or product.min_price != product.max_price %}<small>from </small>{% endif %}<span x-text="appCurrency.format({{ product.min_price }}, '{{ product.currency }}')">{{ formatPrice(product.min_price, product.currency) }}</span></span>{% endif %}
  </div></div>
</a>