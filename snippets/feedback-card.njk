<div x-data="{ expanded: false }" @click="() => expanded = !expanded" class="cursor-pointer h-full">
  <div class="gcard gcard-hover review-card">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <span class="avatar" aria-hidden="true">{% if feedback.customer_email %}{{ feedback.customer_email | first | upper }}{% else %}<svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>{% endif %}</span>
        <div class="min-w-0">
          <p class="text-sm font-semibold truncate">
            {% if feedback.customer_email %}{{ feedback.customer_email.split('@')[0] }}{% elif feedback.customer_name %}{{ feedback.customer_name }}{% else %}{{ 'feedback.verified_buyer' | t }}{% endif %}
          </p>
          <p class="text-xs text-faint">{{ feedback.created_at | formatDate }}</p>
        </div>
      </div>
      <div class="stars flex-none">
        {% for i in range(0, feedback.rating) %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5">
            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
          </svg>
        {% endfor %}
        {% for i in range(0, 5 - feedback.rating) %}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 opacity-30">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
          </svg>
        {% endfor %}
      </div>
    </div>

    <p class="review-text" :class="{ 'truncate': !expanded }">
      {{ feedback.message }}
    </p>

    {% if feedback.image_url and feedback.status != 'disputed' %}
      <img src="{{ feedback.image_url }}" alt="{{ 'feedback.image_alt' | t }}"
           class="w-full max-h-64 object-cover rounded-xl border border-white/5" loading="lazy">
    {% endif %}

    {% if feedback.reply %}
      <div class="panel p-4">
        <p class="text-sm text-muted break-words" :class="{ 'truncate': !expanded }" style="border-left: 2px solid rgb(var(--cl-accent)); padding-left: 0.75rem;">
          {{ feedback.reply }}
        </p>
        <p class="text-xs text-right text-faint mt-2">
          {{ 'feedback.reply_from' | t }} <span style="color: rgb(var(--cl-accent))">{{ shop.name }}</span> · {{ feedback.replied_at | formatDate }}
        </p>
      </div>
    {% endif %}

    <div class="text-xs text-faint truncate pt-2 border-t" style="border-color: color-mix(in srgb, rgb(var(--cl-t-primary)) 6%, transparent);">
      {% if feedback.items|length > 0 %}
        {{ feedback.items[0].name }}
        {% if feedback.items.length > 1 %}
          & {{ feedback.items.length - 1 }} more
        {% endif %}
      {% else %}
        {{ 'feedback.deleted_product' | t }}
      {% endif %}
    </div>
  </div>
</div>