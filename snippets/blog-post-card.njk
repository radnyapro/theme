{% set blog_image_class = ('object-scale-down' if global.properties.blog_image_fit == 'scale-down' else 'object-cover') %}

<a
  class="pcard block h-full"
  href="{{ ('/blog/' + blogPost.path) | shopUrl }}"
>
  <div class="pcard-media">
    {% if blogPost.image_url %}
      <img src="{{ blogPost.image_url }}" alt="{{ blogPost.title }}" class="aspect-blog-card-image w-full {{ blog_image_class }} object-center" loading="lazy" />
    {% else %}
      <div class="flex justify-center items-center aspect-blog-card-image" style="background: color-mix(in srgb, rgb(var(--cl-accent)) 5%, transparent);">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-16" viewBox="0 0 256 256" style="color: color-mix(in srgb, rgb(var(--cl-accent)) 40%, transparent)">
          <path fill="currentColor" d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46ZM43.49 76l38.07-20.85l84.51 46.26L128 122.24ZM218 175.82a2 2 0 0 1-1 1.75L134 223v-90.36l36-19.71V152a6 6 0 0 0 12 0v-45.63l36-19.71Z" />
        </svg>
      </div>
    {% endif %}
  </div>
  <div class="pcard-body">
    <h3 class="pcard-title">{{ blogPost.title }}</h3>
    <p class="pcard-desc">{{ blogPost.summary }}</p>
    <div class="pcard-meta">
      <span class="text-xs text-faint">
        {{ 'blog.published_at' | t }}
        <span class="font-medium">{{ blogPost.created_at | formatDate }}</span>
      </span>
    </div>
  </div>
</a>