<div 
  x-show="appMaintenance.modalIsOpen"
  x-cloak
  class="fixed inset-0 z-50 overflow-y-auto"
  aria-labelledby="login-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div 
      x-show="appMaintenance.modalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appMaintenance.modalClose()"
      class="fixed inset-0 transition-opacity bg-black/75"
      aria-hidden="true"
    ></div>

    <div 
      x-show="appMaintenance.modalIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform border border-white/5 rounded-lg bg-background text-t-primary"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 class="text-xl font-bold truncate">
          {{ 'maintenance.admin_access' | t }}
        </h3>

        <button @click="appMaintenance.modalClose()" class="text-t-primary focus:outline-none hover:text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7 text-t-primary/50 hover:text-accent-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form @submit.prevent="appMaintenance.modalLogin()">
        <label class="block text-t-primary/80">
          {{ 'common.password' | t }}
        </label>
        <div class="mt-2">
          <input 
            type="password"
            x-model="appMaintenance.modalPassword"
            x-ref="appMaintenance.modalPasswordInput"
            placeholder="{{ 'maintenance.password_placeholder' | t }}"
            class="w-full py-2 px-4 text-t-primary bg-white/5 border border-white/5 rounded-lg focus:border-accent-500 focus:ring-accent-500 focus:ring-2 focus:ring-opacity-50 focus:outline-none"
          />
        </div>
        <p x-show="appMaintenance.modalError" class="text-red-500 text-sm mt-2" x-text="appMaintenance.modalError"></p>
        <button
          type="submit"
          class="px-6 py-2 mt-4 w-full rounded-lg flex-1 flex justify-center items-center gap-4 border font-semibold bg-accent-500 border-accent-500 text-t-accent hover:enabled:bg-accent-500/50 transition-colors duration-300 ease-in-out disabled:opacity-50 disabled:pointer-events-none"
          :disabled="appMaintenance.modalLoading"
        >
          <span>{{ 'login.submit' | t }}</span>
          <template x-if="!appMaintenance.modalLoading">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M13 21q-.425 0-.712-.288T12 20t.288-.712T13 19h6V5h-6q-.425 0-.712-.288T12 4t.288-.712T13 3h6q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zm-1.825-8H4q-.425 0-.712-.288T3 12t.288-.712T4 11h7.175L9.3 9.125q-.275-.275-.275-.675t.275-.7t.7-.313t.725.288L14.3 11.3q.3.3.3.7t-.3.7l-3.575 3.575q-.3.3-.712.288T9.3 16.25q-.275-.3-.262-.712t.287-.688z"/></svg>
          </template>
          <template x-if="appMaintenance.modalLoading">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 animate-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>
          </template>
        </button>
      </form>
    </div>
  </div>
</div>