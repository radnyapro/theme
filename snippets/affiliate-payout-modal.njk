<div
  x-show="appAffiliate.modalPayoutIsOpen"
  x-cloak
  class="fixed inset-0 z-50 overflow-y-auto"
  aria-labelledby="affiliate-payout-modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-center min-h-screen px-4 text-center">
    <div
      x-show="appAffiliate.modalPayoutIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click="appAffiliate.modalPayoutClose()"
      class="fixed inset-0 transition-opacity bg-black/75"
      aria-hidden="true"
    ></div>

    <div
      x-show="appAffiliate.modalPayoutIsOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      class="inline-block w-full max-w-lg p-6 my-8 overflow-hidden text-left align-middle transition-all transform border border-white/5 rounded-lg bg-background text-t-primary"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <h3 id="affiliate-payout-modal-title" class="text-xl font-bold truncate">
          {{ 'affiliate.request_payout_title' | t }}
        </h3>

        <button @click="appAffiliate.modalPayoutClose()" class="text-t-primary focus:outline-none hover:text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7 text-t-primary/50 hover:text-accent-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {% if shop.settings.affiliate.payout_instructions %}
        <p class="text-sm text-t-primary/60 mb-4 whitespace-pre-line">{{ shop.settings.affiliate.payout_instructions }}</p>
      {% endif %}

      <form @submit.prevent="appAffiliate.requestPayout()">
        <div class="mb-4">
          <label class="block text-t-primary/80 mb-1">
            {{ 'affiliate.amount_usd_placeholder' | t }}
          </label>
          <input
            type="number"
            min="0.01"
            step="0.01"
            x-model="appAffiliate.payoutAmount"
            placeholder="0.00"
            class="w-full py-2 px-4 text-t-primary bg-white/5 border border-white/5 rounded-md focus:border-accent-500 focus:ring-accent-500 focus:ring-2 focus:ring-opacity-50 focus:outline-none"
            required
          />
          {% if shop.settings.affiliate.payout_min_amount > 0 %}
            <p class="text-xs text-t-primary/50 mt-1">
              Minimum: <span x-text="appCurrency.format({{ shop.settings.affiliate.payout_min_amount }}, 'USD')">{{ formatPrice(shop.settings.affiliate.payout_min_amount, 'USD') }}</span>
            </p>
          {% endif %}
        </div>

        <div class="mb-4">
          <label class="block text-t-primary/80 mb-1">
            {{ 'affiliate.payout_details' | t }}
          </label>
          <textarea
            rows="3"
            x-model="appAffiliate.payoutDetails"
            placeholder="{{ 'affiliate.payout_details_placeholder' | t }}"
            class="w-full py-2 px-4 text-t-primary bg-white/5 border border-white/5 rounded-md focus:border-accent-500 focus:ring-accent-500 focus:ring-2 focus:ring-opacity-50 focus:outline-none"
            required
          ></textarea>
        </div>

        <p x-show="appAffiliate.payoutError" class="text-red-500 text-sm mt-2" x-text="appAffiliate.payoutError"></p>

        <button
          type="submit"
          class="px-6 py-2 mt-4 w-full rounded-lg flex-1 flex justify-center items-center gap-4 border font-semibold bg-accent-500 border-accent-500 text-t-accent hover:enabled:bg-accent-500/50 transition-colors duration-300 ease-in-out disabled:opacity-50 disabled:pointer-events-none"
          :disabled="appAffiliate.payoutLoading"
        >
          <span>{{ 'affiliate.request_payout' | t }}</span>
          <template x-if="!appAffiliate.payoutLoading">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="currentColor" viewBox="0 0 256 256"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg>
          </template>
          <template x-if="appAffiliate.payoutLoading">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 animate-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>
          </template>
        </button>
      </form>
    </div>
  </div>
</div>
