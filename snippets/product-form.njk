{% set instantBalanceAvailable = instant_balance and instant_balance.enabled and shop_customer and not properties.hide_instant_balance_buy %}

<form @submit.prevent="buyNow">
  <div class="p-5 md:p-6">
    {% if product.variants.length > 1 %}
      <div class="mb-5 pb-5" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 7%, transparent);">
        <label for="variant" class="block mb-2.5 text-[0.82rem] font-semibold text-muted">{{ 'product.variant' | t }}</label>
        {% if properties.variant_selector == 'dropdown' %}
          <select name="variant" @change="() => activeVariant = $event.target.value" class="input">
            <template x-for="(variant, index) in product.variants" :key="index">
              <option
                :value="index"
                :selected="activeVariant == index"
                x-text="variant.name + ' (' + appCurrency.format(variant.price, product.currency) + ')'"
              ></option>
            </template>
          </select>
        {% else %}
          <div class="flex flex-col gap-2">
            {% for variant in product.variants %}
              <button
                type="button"
                class="flex items-center justify-between gap-4 px-4 py-3 border rounded-[var(--radius-input)] text-t-primary text-left transition-colors duration-200"
                :class="`${activeVariant == {{ loop.index0 }} ? 'variant-active' : 'variant-idle'} ${({{ 'true' if variant.stock === 0 else 'false' }} || activeVariant == {{ loop.index0 }}) ? '' : 'hover:variant-idle-hover'}`"
                @click="() => activeVariant = {{ loop.index0 }}"
                title="{{ ('product.out_of_stock' | t) if variant.stock === 0 else '' }}"
                {{ 'disabled' if variant.stock === 0 }}
              >
                <div class="flex-1 flex flex-col items-start gap-1 min-w-0">
                  <p class="text-[0.95rem] font-medium truncate">{{ variant.name }}</p>
                  {% if variant.description %}
                    <p class="text-xs text-faint">
                      <span class="whitespace-pre-line">{{ variant.description }}</span>
                    </p>
                  {% endif %}
                  <p class="text-xs text-muted">
                    {% if variant.stock === 0 %}
                      <span>{{ 'product.out_of_stock' | t }}</span>
                    {% elif product.hide_stock_count %}
                      <span>{{ 'product.in_stock' | t }}</span>
                    {% elif variant.stock === -1 %}
                      <span class="inline-flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" style="color: rgb(var(--status-positive))" fill="currentColor" viewBox="0 0 256 256"><path d="M248,128a56,56,0,0,1-95.6,39.6l-.33-.35L92.12,99.55a40,40,0,1,0,0,56.9l8.52-9.62a8,8,0,1,1,12,10.61l-8.69,9.81-.33.35a56,56,0,1,1,0-79.2l.33.35,59.95,67.7a40,40,0,1,0,0-56.9l-8.52,9.62a8,8,0,1,1-12-10.61l8.69-9.81.33-.35A56,56,0,0,1,248,128Z"></path></svg>
                        {{ 'product.in_stock' | t }}
                      </span>
                    {% else %}
                      <span>{{ 'product.in_stock_count' | t({ count: variant.stock }) }}</span>
                    {% endif %}
                  </p>
                </div>
                <div class="px-2.5 py-1 rounded-lg text-sm font-medium flex-none" style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 5%, transparent);">
                  <span x-text="appCurrency.format({{ variant.price }}, '{{ product.currency }}')">
                    {{ formatPrice(variant.price, product.currency) }}
                  </span>
                  {% if variant.price_slash %}
                    <span class="text-xs text-faint line-through ml-1">
                      <span x-text="appCurrency.format({{ variant.price_slash }}, '{{ product.currency }}')">
                        {{ formatPrice(variant.price_slash, product.currency) }}
                      </span>
                    </span>
                  {% endif %}
                </div>
              </button>
            {% endfor %}
          </div>
        {% endif %}
        <small x-show="!(activeVariant in product.variants)" x-cloak class="text-sm mt-1.5 block" style="color: rgb(var(--status-error))">
          {{ 'product.select_variant' | t }}
        </small>
      </div>
    {% endif %}

    {% if product.cashback_percentage > 0 %}
      <div class="mb-5 flex items-center gap-2.5 rounded-[var(--radius-input)] border px-3.5 py-2.5 text-sm" style="border-color: color-mix(in srgb, rgb(var(--cl-accent)) 25%, transparent); background: color-mix(in srgb, rgb(var(--cl-accent)) 7%, transparent);">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" style="color: rgb(var(--cl-accent))" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m15 9-6 6"/><path d="M9 9h.01"/><path d="M15 15h.01"/></svg>
        <span>{{ 'product.cashback_notice' | t({ percentage: product.cashback_percentage }) | safe }}</span>
      </div>
    {% endif %}

    <div class="mb-5 pb-5" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 7%, transparent);">
      <label for="quantity" class="block mb-2.5 text-[0.82rem] font-semibold text-muted">{{ 'common.quantity' | t }}</label>
      <div class="flex rounded-[var(--radius-input)] overflow-hidden border" style="border-color: color-mix(in srgb, rgb(var(--cl-t-primary)) 10%, transparent);">
        <button
          @click="changeQuantity(quantity - 1)"
          type="button"
          class="size-11 flex justify-center items-center transition-colors disabled:pointer-events-none disabled:opacity-40"
          style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 5%, transparent);"
          :disabled="outOfStock || quantity <= minQuantity"
          aria-label="Decrease quantity"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.8"
            stroke="currentColor"
            class="size-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 12h-15"
            />
          </svg>
        </button>
        <input
          type="number"
          class="flex-1 min-w-0 text-center text-t-primary text-sm focus:outline-none py-2 px-2 disabled:opacity-50"
          style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 3%, transparent);"
          name="quantity"
          x-model.number="quantity"
          :min="minQuantity"
          :max="maxQuantity"
          :disabled="outOfStock"
          aria-label="{{ 'common.quantity' | t }}"
        />
        <button
          @click="changeQuantity(quantity + 1)"
          type="button"
          class="size-11 flex justify-center items-center transition-colors disabled:pointer-events-none disabled:opacity-40"
          style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 5%, transparent);"
          :disabled="outOfStock || quantity >= maxQuantity"
          aria-label="Increase quantity"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.8"
            stroke="currentColor"
            class="size-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 4.5v15m7.5-7.5h-15"
            />
          </svg>
        </button>
      </div>

      <small
        x-show="!outOfStock && (quantity < minQuantity || quantity > maxQuantity)"
        x-cloak
        class="text-sm mt-1.5 block"
        style="color: rgb(var(--status-error))"
      >
        <span x-html="'{{ 'product.quantity_invalid' | t | jsEscape }}'.replace('{min}', minQuantity).replace('{max}', maxQuantity)"></span>
      </small>

      <div
        x-show="variant.volume_discounts && variant.volume_discounts.length"
        x-cloak
        class="vdt"
        x-effect="vdTrack()"
      >
        <div class="vdt-head">
          <span class="vdt-title">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-2 8h7l-9 12 2-8H4l9-12Z"/></svg>
            Volume discounts
          </span>
          <span class="vdt-save" x-show="volumeSaved" x-cloak>
            You save <b x-text="appCurrency.format(volumeSaved, product.currency)"></b>
          </span>
        </div>

        <div class="vdt-bar">
          <div class="vdt-fill" :style="'width:' + volumeBarWidth + '%'"></div>
          <template x-for="t in volumeTierList" :key="t.quantity">
            <div
              class="vdt-node"
              :class="{
                'is-reached': t.reached,
                'is-next': nextVolumeDiscount && parseInt(nextVolumeDiscount.quantity) === t.quantity,
                'is-flash': vdFlash === t.quantity,
                'is-edge-l': t.align === 'l',
                'is-edge-r': t.align === 'r'
              }"
              :style="'left:' + t.pos + '%'"
            >
              <span class="vdt-node-q" x-text="'×' + t.quantity"></span>
              <span class="vdt-node-dot"></span>
              <span class="vdt-node-pct" x-text="'-' + t.percentage + '%'"></span>
            </div>
          </template>
        </div>

        <div class="vdt-hint">
          <span x-show="nextVolumeDiscount">
            Buy <b class="vdt-b" x-text="volumeRemaining"></b> more → unlock
            <b class="vdt-b" x-text="nextVolumeDiscount ? nextVolumeDiscount.percentage + '%' : ''"></b> off
          </span>
          <span x-show="!nextVolumeDiscount" x-cloak class="vdt-hint-max">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 9.1 8.6 2 9.2l5.5 4.7L5.8 21 12 17.3 18.2 21l-1.7-7.1L22 9.2l-7.1-.6L12 2Z"/></svg>
            Best price unlocked
          </span>
        </div>

        <div class="vdt-price" x-show="getAppliedVolumeDiscount()" x-cloak>
          <s x-text="appCurrency.format(volumeOriginalTotal, product.currency)"></s>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          <span class="vdt-price-new" x-text="appCurrency.format(volumeDiscountedTotal, product.currency)"></span>
        </div>
      </div>
    </div>

    {% if productAddons and productAddons.length > 0 %}
      <div class="mb-5 pb-5" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 7%, transparent);">
        <label class="block mb-2.5 text-[0.82rem] font-semibold text-muted">{{ 'product.addons' | t }}</label>
        <div class="flex flex-col gap-2">
          {% for addon in productAddons %}
            <div class="flex items-center justify-between gap-4 px-4 py-3 border rounded-[var(--radius-input)] text-t-primary" style="border-color: color-mix(in srgb, rgb(var(--cl-t-primary)) 8%, transparent); background: color-mix(in srgb, rgb(var(--cl-t-primary)) 3%, transparent);">
              <div class="flex-1 flex items-center gap-3 text-left min-w-0">
                {% if addon.image_urls and addon.image_urls[0] %}
                  <img
                    src="{{ addon.image_urls[0] }}"
                    alt="{{ addon.name }}"
                    class="size-10 rounded-lg object-cover flex-none"
                  >
                {% endif %}
                <div class="flex flex-col gap-1 min-w-0">
                  <p class="text-sm font-medium truncate">{{ addon.name }}</p>
                  {% if addon.description %}
                    <p class="text-xs text-faint">
                      <span class="whitespace-pre-line">{{ addon.description }}</span>
                    </p>
                  {% endif %}
                </div>
              </div>
              <div class="flex items-center gap-3 flex-none">
                <div class="text-t-primary text-sm">
                  <span x-text="appCurrency.format('{{ addon.variants[0].price }}', '{{ addon.currency }}')">
                    {{ formatPrice(addon.variants[0].price, addon.currency) }}
                  </span>
                </div>
                <button
                  type="button"
                  x-show="!appCart.isInCart({{ addon.variants[0].id }}, variant.id)"
                  x-on:click="appCart.add({{ addon.id }}, {{ addon.variants[0].id }}, 1, variant.id)"
                  class="btn btn-ghost btn-sm"
                  :disabled="outOfStock || product.visibility == 'on_hold' || cartLimitReached || addingToCart"
                >
                  <span>{{ 'common.add' | t }}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><path fill="currentColor" d="M11 13H6q-.425 0-.712-.288T5 12t.288-.712T6 11h5V6q0-.425.288-.712T12 5t.713.288T13 6v5h5q.425 0 .713.288T19 12t-.288.713T18 13h-5v5q0 .425-.288.713T12 19t-.712-.288T11 18z"/></svg>
                </button>
                {% if addon.is_mandatory %}
                  <button
                    type="button"
                    x-show="appCart.isInCart({{ addon.variants[0].id }}, variant.id)"
                    class="btn btn-bloom btn-sm"
                    disabled
                    title="{{ 'product.addon_mandatory' | t }}"
                  >
                    <span>{{ 'product.added' | t }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                  </button>
                {% else %}
                  <button
                    type="button"
                    x-show="appCart.isInCart({{ addon.variants[0].id }}, variant.id)"
                    x-on:click="appCart.remove({{ addon.variants[0].id }}, variant.id)"
                    class="btn btn-sm"
                    style="border-color: color-mix(in srgb, rgb(var(--status-error)) 40%, transparent); color: rgb(var(--status-error));"
                    :disabled="outOfStock || product.visibility == 'on_hold' || cartLimitReached || addingToCart"
                  >
                    <span>{{ 'common.remove' | t }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275-.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"/></svg>
                  </button>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if quantity_deals and quantity_deals.length %}
      <div class="mb-5 pb-5" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 7%, transparent);">
        <label class="block mb-2.5 text-[0.82rem] font-semibold text-muted">{{ 'product.quantity_deals' | t }}</label>
        <div class="flex flex-col gap-2">
          {% for deal in quantity_deals %}
            {% set bundleSize = deal.buy_quantity + deal.discounted_quantity %}
            <div
              class="flex items-center justify-between gap-3 border rounded-[var(--radius-input)] px-4 py-3"
              style="border-color: color-mix(in srgb, rgb(var(--cl-t-primary)) 8%, transparent); background: color-mix(in srgb, rgb(var(--cl-t-primary)) 3%, transparent);"
              {% if deal.variant_id %}
                x-show="variant.id === {{ deal.variant_id }}"
                x-cloak
              {% endif %}
            >
              <div class="flex flex-col gap-1 flex-1 min-w-0">
                <p class="text-sm font-medium text-t-primary truncate">{{ deal.name }}</p>
                <p class="text-xs text-muted">
                  {% if deal.percentage == 100 %}
                    Buy {{ deal.buy_quantity }}{% if deal.variant_name %} {{ deal.variant_name }}{% endif %}, get {{ deal.discounted_quantity }} free
                  {% else %}
                    Buy {{ deal.buy_quantity }}{% if deal.variant_name %} {{ deal.variant_name }}{% endif %}, get {{ deal.discounted_quantity }} at {{ deal.percentage }}% off
                  {% endif %}
                  {% if deal.max_uses_per_cart %}
                    &nbsp;&middot;&nbsp;Max {{ deal.max_uses_per_cart }}&times; per order
                  {% endif %}
                  {% if deal.ends_at %}
                    &nbsp;&middot;&nbsp;<span class="text-faint">Ends {{ deal.ends_at | formatDate }}</span>
                  {% endif %}
                </p>
              </div>
              <div class="flex flex-col items-center gap-1.5 flex-shrink-0">
                <span class="pill pill-accent !h-6 !text-[0.7rem] font-bold">
                  {% if deal.percentage == 100 %}FREE{% else %}-{{ deal.percentage }}%{% endif %}
                </span>
                <button
                  type="button"
                  x-show="quantity < {{ bundleSize }}"
                  @click="changeQuantity({{ bundleSize }})"
                  class="text-xs font-medium whitespace-nowrap hover:underline"
                  style="color: rgb(var(--cl-accent))"
                >
                  Buy {{ bundleSize }}
                </button>
                <span
                  x-show="quantity >= {{ bundleSize }}"
                  x-cloak
                  class="flex items-center gap-1 text-xs font-medium whitespace-nowrap"
                  style="color: rgb(var(--cl-accent))"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                  {{ 'common.active' | t }}
                </span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if bundle_offers and bundle_offers.length %}
      <script>
        window.__bundleOffers = {{ bundle_offers | json }};
      </script>
      <div class="mb-5 pb-5" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 7%, transparent);">
        <label class="block mb-2.5 text-[0.82rem] font-semibold text-muted">{{ 'product.bundle_offers' | t }}</label>
        <div class="flex flex-col gap-3">
          {% for offer in bundle_offers %}
            <div class="flex flex-col gap-3 border rounded-[var(--radius-input)] px-4 py-3" style="border-color: color-mix(in srgb, rgb(var(--cl-t-primary)) 8%, transparent); background: color-mix(in srgb, rgb(var(--cl-t-primary)) 3%, transparent);">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-semibold text-t-primary">{{ offer.name }}</span>
                {% if offer.ends_at %}
                  <span class="text-xs text-faint flex-shrink-0">Ends {{ offer.ends_at | formatDate }}</span>
                {% endif %}
              </div>
              <p class="text-xs text-muted">
                {% if offer.type == "percentage" %}
                  Save {{ offer.discount }}% when you add all items
                {% else %}
                  Save <span x-text="appCurrency.format({{ offer.discount }}, '{{ product.currency }}')">{{ formatPrice(offer.discount, product.currency) }}</span> when you add all items
                {% endif %}
                {% if offer.max_uses_per_cart %}
                  &nbsp;&middot;&nbsp;Max {{ offer.max_uses_per_cart }}&times; per order
                {% endif %}
              </p>
              <ul class="flex flex-col gap-2">
                {% for item in offer.items %}
                  <li class="flex items-center gap-3 text-t-primary">
                    {% if item.image_url %}
                      <img src="{{ item.image_url }}" alt="{{ item.name }}" class="size-8 rounded-lg object-cover flex-shrink-0">
                    {% else %}
                      <div class="size-8 rounded-lg flex-shrink-0" style="background: color-mix(in srgb, rgb(var(--cl-t-primary)) 6%, transparent);"></div>
                    {% endif %}
                    <div class="flex-1 min-w-0">
                      {% if item.path and not item.is_current %}
                        <a href="{{ '/product/' | shopUrl }}{{ item.path }}" class="text-xs font-medium hover:text-accent-500 transition truncate block">
                          {{ item.name }}{% if item.quantity > 1 %} &times;{{ item.quantity }}{% endif %}
                        </a>
                      {% else %}
                        <span class="text-xs font-medium truncate block">
                          {{ item.name }}{% if item.quantity > 1 %} &times;{{ item.quantity }}{% endif %}
                        </span>
                      {% endif %}
                    </div>
                    {% set currentItemVariantRef = item.id if item.type == 'variant' else 'variant.id' %}
                    {% if item.is_current %}
                      <span x-show="appCart.isInCart({{ currentItemVariantRef }})" class="flex items-center gap-1.5 text-xs font-medium flex-shrink-0" style="color: rgb(var(--cl-accent))">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                        {{ 'product.in_cart' | t }}
                        <button type="button" @click="removeFromCart({{ currentItemVariantRef }}); addedToCart = false" class="text-t-primary/30 hover:text-red-400 transition leading-none">&times;</button>
                      </span>
                      <span x-show="!appCart.isInCart({{ currentItemVariantRef }})" class="text-xs text-faint flex-shrink-0">{{ 'product.this_item' | t }}</span>
                    {% elif item.type == 'variant' %}
                      <span x-show="appCart.isInCart({{ item.id }})" x-cloak class="flex items-center gap-1.5 text-xs font-medium flex-shrink-0" style="color: rgb(var(--cl-accent))">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                        {{ 'product.in_cart' | t }}
                        <button type="button" @click="removeFromCart({{ item.id }})" class="text-t-primary/30 hover:text-red-400 transition leading-none">&times;</button>
                      </span>
                      <button
                        type="button"
                        x-show="!appCart.isInCart({{ item.id }})"
                        @click="appCart.add({{ item.product_id }}, {{ item.id }}, {{ item.quantity }})"
                        class="btn btn-ghost !h-7 !px-2.5 !text-[0.72rem] flex-shrink-0"
                      >+ Add</button>
                    {% elif item.variants and item.variants[0] %}
                      <span x-show="appCart.isInCart({{ item.variants[0].id }})" x-cloak class="flex items-center gap-1.5 text-xs font-medium flex-shrink-0" style="color: rgb(var(--cl-accent))">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                        {{ 'product.in_cart' | t }}
                        <button type="button" @click="removeFromCart({{ item.variants[0].id }})" class="text-t-primary/30 hover:text-red-400 transition leading-none">&times;</button>
                      </span>
                      <button
                        type="button"
                        x-show="!appCart.isInCart({{ item.variants[0].id }})"
                        @click="appCart.add({{ item.id }}, {{ item.variants[0].id }}, {{ item.quantity }})"
                        class="btn btn-ghost !h-7 !px-2.5 !text-[0.72rem] flex-shrink-0"
                      >+ Add</button>
                    {% elif item.path %}
                      <a href="{{ '/product/' | shopUrl }}{{ item.path }}" class="btn btn-ghost !h-7 !px-2.5 !text-[0.72rem] flex-shrink-0">{{ 'common.view' | t }}</a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
              <div>
                <button
                  type="button"
                  x-show="!isBundleComplete({{ offer.id }})"
                  @click="addBundleItems({{ offer.id }})"
                  class="btn btn-ghost btn-block"
                >
                  {{ 'product.add_all_to_cart' | t }}
                </button>
                <div
                  x-show="isBundleComplete({{ offer.id }})"
                  x-cloak
                  class="flex items-center justify-center gap-2 text-sm py-2"
                  style="color: rgb(var(--cl-accent))"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 15.15l8.475-8.475q.3-.3.7-.3t.7.3t.3.713t-.3.712l-9.175 9.2q-.3.3-.7.3t-.7-.3L4.55 13q-.3-.3-.288-.712t.313-.713t.713-.3t.712.3z"/></svg>
                  {{ 'product.bundle_all_in_cart' | t }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if altcha and not properties.hide_buy_now %}
      <div
        x-cloak
        x-show="!altchaPayload"
        class="transition-opacity"
        x-transition:enter="transition ease-out duration-300 transform"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200 transform"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
      >
        <altcha-widget
          challengejson='{{ altcha | json }}'
          auto="onload"
          hidefooter="true"
          hidelogo="true"
          x-ref="altcha"
        ></altcha-widget>
      </div>
    {% endif %}

    <div
      x-cloak
      x-show="buyNowError"
      class="transition-opacity"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
    >
      <div class="p-4 rounded-[var(--radius-input)] mt-4 text-sm" style="background: color-mix(in srgb, rgb(var(--status-error)) 15%, transparent); color: rgb(var(--status-error));">
        <span x-text="buyNowError"></span>
      </div>
    </div>

    <div class="flex flex-col gap-3 mt-5 sm:flex-row">
      {% if not properties.hide_add_to_cart %}
        <button
          type="button"
          x-show="variant.subscription_mode !== 'required'"
          x-on:click="addToCart"
          class="btn btn-bloom flex-1"
          :disabled="outOfStock || product.visibility == 'on_hold' || cartLimitReached || addingToCart"
        >
          <template x-if="!addingToCart && !addedToCart">
            <span class="inline-flex justify-center items-center gap-2">
              <span x-text="cartLimitReached ? '{{ 'product.cart_limit_reached' | t | jsEscape }}' : '{{ 'product.add_to_cart' | t | jsEscape }}'"></span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 256 256"><path d="M230.14,58.87A8,8,0,0,0,224,56H62.68L56.6,22.57A8,8,0,0,0,48.73,16H24a8,8,0,0,0,0,16h18L67.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42A27.75,27.75,0,0,0,160,204a28,28,0,1,0,28-28H91.17a8,8,0,0,1-7.87-6.57L80.13,152h116a24,24,0,0,0,23.61-19.71l12.16-66.86A8,8,0,0,0,230.14,58.87ZM104,204a12,12,0,1,1-12-12A12,12,0,0,1,104,204Zm96,0a12,12,0,1,1-12-12A12,12,0,0,1,200,204Zm4-74.57A8,8,0,0,1,196.1,136H77.22L65.59,72H214.41Z"></path></svg>
            </span>
          </template>
          <template x-if="addingToCart">
            <span class="inline-flex justify-center items-center gap-2">
              <span>Adding...&nbsp;&nbsp;</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>
            </span>
          </template>
          <template x-if="addedToCart">
            <span class="inline-flex justify-center items-center gap-2">
              <span>{{ 'product.go_to_cart' | t }}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 256 256"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg>
            </span>
          </template>
        </button>
      {% endif %}
      {% if not properties.hide_buy_now %}
        <button
          type="submit"
          class="btn btn-ghost flex-1"
          :disabled="outOfStock || product.visibility == 'on_hold' || buyingNow || buyNowDisabled"
        >
          <span x-text="variant.subscription_mode === 'required' ? subscribeLabel : '{{ 'product.buy_now' | t | jsEscape }}'">{{ 'product.buy_now' | t }}</span>
          <template x-if="!buyingNow">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 256 256"><path d="M237.66,122.34l-96-96A8,8,0,0,0,128,32V72H104a8,8,0,0,0-8,8v96a8,8,0,0,0,8,8h24v40a8,8,0,0,0,13.66,5.66l96-96A8,8,0,0,0,237.66,122.34ZM144,204.69V176a8,8,0,0,0-8-8H112V88h24a8,8,0,0,0,8-8V51.31L220.69,128ZM48,80v96a8,8,0,0,1-16,0V80a8,8,0,0,1,16,0Zm32,0v96a8,8,0,0,1-16,0V80a8,8,0,0,1,16,0Z"></path></svg>
          </template>
          <template x-if="buyingNow">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>
          </template>
        </button>
      {% endif %}
    </div>
    {% if not properties.hide_buy_now %}
      <div x-cloak x-show="variant.subscription_mode === 'optional'" class="mt-3">
        <button
          type="button"
          x-on:click="subscribeNow"
          class="btn btn-soft btn-block"
          :disabled="outOfStock || product.visibility == 'on_hold' || buyingNow || buyNowDisabled"
        >
          <span x-text="subscribeLabel"></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 256 256"><path d="M240,56v48a8,8,0,0,1-8,8H184a8,8,0,0,1,0-16H211.4L184.81,71.64l-.25-.24a80,80,0,1,0-1.67,114.78,8,8,0,0,1,11,11.63A95.44,95.44,0,0,1,128,224h-1.32A96,96,0,1,1,195.75,60L224,85.8V56a8,8,0,1,1,16,0Z"></path></svg>
        </button>
      </div>
    {% endif %}

    {% if instantBalanceAvailable %}
      <div x-cloak x-show="instantBalanceEligible" class="mt-3">
        <button
          type="button"
          x-on:click="openInstantBalance"
          class="btn btn-soft btn-block"
          :disabled="outOfStock || product.visibility == 'on_hold' || !instantBalanceAffordable || instantLoading"
        >
          <span x-text="instantBalanceAffordable ? '{{ 'product.instant_balance_buy' | t | jsEscape }}' : '{{ 'product.instant_balance_insufficient' | t | jsEscape }}'"></span>
          <template x-if="!instantLoading">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 256 256"><path d="M216,64H56a8,8,0,0,1,0-16H192a8,8,0,0,0,0-16H56A24,24,0,0,0,32,56V184a24,24,0,0,0,24,24H216a16,16,0,0,0,16-16V80A16,16,0,0,0,216,64Zm0,128H56a8,8,0,0,1-8-8V78.63A23.84,23.84,0,0,0,56,80H216Zm-48-60a12,12,0,1,1,12,12A12,12,0,0,1,168,132Z"></path></svg>
          </template>
          <template x-if="instantLoading">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 animate-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>
          </template>
        </button>
        <p class="mt-2 text-xs text-center text-faint">
          <span x-text="'{{ 'product.instant_balance_your_balance' | t | jsEscape }}'.replace('{amount}', instantFormat(customerBalance, 'USD'))"></span>
          <template x-if="!instantBalanceAffordable">
            <a href="{{ '/customer/balance' | shopUrl }}" class="ml-1 underline hover:text-accent-500">{{ 'product.instant_balance_top_up' | t }}</a>
          </template>
        </p>
      </div>
    {% endif %}
  </div>
</form>

{% if instantBalanceAvailable %}
  <div
    x-show="instantOpen"
    x-cloak
    class="fixed inset-0 z-50 overflow-y-auto"
    aria-label="{{ 'product.instant_balance_title' | t }}"
    role="dialog"
    aria-modal="true"
  >
    <div class="flex items-center justify-center min-h-screen px-4 text-center">
      <div
        x-show="instantOpen"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @click="closeInstantBalance()"
        class="modal-backdrop"
        aria-hidden="true"
      ></div>

      <div
        x-show="instantOpen"
        x-transition:enter="transition ease-out duration-300 transform"
        x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
        x-transition:leave="transition ease-in duration-200 transform"
        x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
        x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        class="modal-card text-left"
      >
        <div class="flex items-start justify-between gap-4 mb-4">
          <h3 class="font-display text-xl font-bold tracking-tight truncate">
            {{ 'product.instant_balance_title' | t }}
          </h3>

          <button type="button" @click="closeInstantBalance()" class="icon-btn" aria-label="{{ 'common.close' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <template x-if="instantQuote">
          <div>
            <div class="flex flex-col gap-2 pb-4" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 8%, transparent);">
              <template x-for="(item, index) in instantQuote.items" :key="index">
                <div class="flex items-baseline justify-between gap-4 text-sm">
                  <span x-text="item.name + ' × ' + item.quantity"></span>
                  <span class="whitespace-nowrap" x-text="instantFormat(item.total_price, instantQuote.currency)"></span>
                </div>
              </template>
            </div>

            <div class="flex flex-col gap-2 py-4" style="border-bottom: 1px solid color-mix(in srgb, rgb(var(--cl-t-primary)) 8%, transparent);">
              <div class="flex items-baseline justify-between gap-4 font-semibold">
                <span>{{ 'product.instant_balance_total' | t }}</span>
                <span class="whitespace-nowrap tgrad font-display text-lg" x-text="instantFormat(instantQuote.price, instantQuote.currency)"></span>
              </div>
              <div x-show="instantQuote.has_tax_or_fees" class="text-xs text-right text-faint">
                {{ 'product.instant_balance_incl_tax_fees' | t }}
              </div>
              <div x-show="instantQuote.currency !== 'USD'" class="flex items-baseline justify-between gap-4 text-sm text-faint">
                <span>{{ 'product.instant_balance_charged' | t }}</span>
                <span class="whitespace-nowrap" x-text="instantFormat(instantQuote.price_usd, 'USD')"></span>
              </div>
            </div>

            <div class="flex items-baseline justify-between gap-4 py-4 text-sm">
              <span class="text-muted">{{ 'product.instant_balance_balance' | t }}</span>
              <span class="whitespace-nowrap">
                <span class="text-faint" x-text="instantFormat(instantQuote.balance, 'USD')"></span>
                <span class="mx-1 text-faint">→</span>
                <span class="font-semibold" x-text="instantFormat(instantQuote.balance_after, 'USD')"></span>
              </span>
            </div>

            <p x-show="instantQuote.collects_fields_after" class="mb-4 text-xs text-faint">
              {{ 'product.instant_balance_fields_after' | t }}
            </p>

            <p x-cloak x-show="instantError" class="p-3 mb-4 text-sm rounded-[var(--radius-input)]" style="background: color-mix(in srgb, rgb(var(--status-error)) 15%, transparent); color: rgb(var(--status-error));" x-text="instantError"></p>

            <div class="flex flex-col gap-2 sm:flex-row">
              <button
                type="button"
                @click="closeInstantBalance()"
                class="btn btn-soft flex-1"
              >
                {{ 'product.instant_balance_cancel' | t }}
              </button>
              <template x-if="instantQuote.can_pay">
                <button
                  type="button"
                  @click="confirmInstantBalance()"
                  :disabled="instantPaying"
                  class="btn btn-bloom flex-1"
                >
                  <span x-text="instantPaying ? '{{ 'product.instant_balance_paying' | t | jsEscape }}' : '{{ 'product.instant_balance_confirm' | t | jsEscape }}'"></span>
                </button>
              </template>
              <template x-if="!instantQuote.can_pay">
                <a
                  href="{{ '/customer/balance' | shopUrl }}"
                  class="btn btn-bloom flex-1"
                >
                  {{ 'product.instant_balance_top_up' | t }}
                </a>
              </template>
            </div>
          </div>
        </template>

        <template x-if="!instantQuote">
          <p x-text="instantError || '{{ 'product.instant_balance_loading' | t | jsEscape }}'" class="text-sm text-faint"></p>
        </template>
      </div>
    </div>
  </div>
{% endif %}

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('productForm', () => ({
      product: {{ product | json }},
      productAddons: {{ productAddons | json }},
      quantityDeals: {{ (quantity_deals or []) | json }},
      activeVariant: 0,
      quantity: {{ product.quantity_min or 1 }},
      vdFlash: null,
      vdAppliedTier: null,
      addingToCart: false,
      addedToCart: false,
      buyingNow: false,
      buyNowError: null,
      buyNowDisabled: false,
      altchaPayload: null,
      subscribeIntent: false,
      instantBalance: {{ (instant_balance or {}) | json }},
      instantOpen: false,
      instantQuote: null,
      instantLoading: false,
      instantPaying: false,
      instantError: null,

      get variant() {
        return this.product.variants[this.activeVariant];
      },

      get subscribeLabel() {
        const v = this.variant;
        if (!v || v.subscription_mode === 'disabled') return 'Subscribe';
        const count = v.recurring_interval_count || 1;
        const interval = count > 1 ? `${count} ${v.recurring_interval}s` : v.recurring_interval;
        const price = this.appCurrency
          ? this.appCurrency.format(v.recurring_price, this.product.currency)
          : v.recurring_price;
        return `Subscribe — ${price} / ${interval}`;
      },

      subscribeNow: function () {
        this.subscribeIntent = true;
        this.buyNow().finally(() => { this.subscribeIntent = false; });
      },

      init: function () {
        const urlParams = new URLSearchParams(window.location.search);

        // Prefill variant from URL parameter if present.
        if (urlParams.has('variant')) {
          const variantIndex = this.product.variants.findIndex(variant => variant.name === urlParams.get('variant'));
          if (variantIndex !== -1) {
            this.activeVariant = variantIndex;
          }
        } else {
          // Choose the first variant that has stock.
          for (let i = 0; i < this.product.variants.length; i++) {
            if (this.product.variants[i].stock !== 0) {
              this.activeVariant = i;
              break;
            }
          }
        }

        if (this.variant.quantity_min) {
          this.quantity = this.variant.quantity_min;
        }

        if (urlParams.has('quantity')) {
          const urlQuantity = parseInt(urlParams.get('quantity'));
          if (!isNaN(urlQuantity) && urlQuantity >= this.minQuantity && urlQuantity <= this.maxQuantity) {
            this.quantity = urlQuantity;
          }
        }

        this.$watch('activeVariant', (newVal, oldVal) => {
          const oldVariant = this.product.variants[oldVal];
          if (oldVariant) {
            for (const addon of this.productAddons) {
              if (!addon.is_mandatory) {
                this.appCart.remove(addon.variants[0].id, oldVariant.id);
              }
            }
          }

          this.quantity = this.product.quantity_min || 1;

          if (this.variant.quantity_min) {
            this.quantity = this.variant.quantity_min;
          }

          this.addedToCart = false;

          for (const addon of this.productAddons) {
            if (addon.is_mandatory) {
              if (!this.appCart.isInCart(addon.variants[0].id, this.variant.id)) {
                this.appCart.add(addon.id, addon.variants[0].id, 1, this.variant.id);
              }
            }
          }
        });

        this.$watch('quantity', () => {
          this.addedToCart = false;
        });

        {% if altcha and not properties.hide_buy_now %}
          this.addAltchaEventListener();
        {% endif %}

        window.addEventListener('pageshow', (event) => {
          if (event.persisted) {
            this.buyingNow = false;
          }
        });
      },

      get nextVolumeDiscount() {
        if (this.variant.volume_discounts) {
          const volumeDiscounts = [...this.variant.volume_discounts].sort((a, b) => a.quantity - b.quantity);

          for (const volumeDiscount of volumeDiscounts) {
            if (this.quantity < parseInt(volumeDiscount.quantity)) {
              return volumeDiscount;
            }
          }
        }

        return null;
      },

      getAppliedVolumeDiscount: function (quantity = null) {
        if (quantity === null) {
          quantity = this.quantity;
        }

        if (this.variant.volume_discounts) {
          const volumeDiscounts = [...this.variant.volume_discounts].sort((a, b) => b.quantity - a.quantity);

          for (const volumeDiscount of volumeDiscounts) {
            if (quantity >= parseInt(volumeDiscount.quantity)) {
              return volumeDiscount;
            }
          }
        }

        return null;
      },

      get volumeTierList() {
        if (!this.variant.volume_discounts) return [];
        const sorted = [...this.variant.volume_discounts].sort((a, b) => parseInt(a.quantity) - parseInt(b.quantity));
        const maxQ = parseInt(sorted[sorted.length - 1].quantity) || 1;
        return sorted.map(d => {
          const q = parseInt(d.quantity);
          const raw = (q / maxQ) * 100;
          const pos = Math.min(Math.max(raw, 6), 94);
          return {
            quantity: q,
            percentage: d.percentage,
            pos,
            align: raw <= 6 ? 'l' : (raw >= 94 ? 'r' : 'c'),
            reached: this.quantity >= q
          };
        });
      },

      get volumeBarWidth() {
        const list = this.volumeTierList;
        if (!list.length) return 0;
        const maxQ = list[list.length - 1].quantity;
        return Math.min(Math.max((this.quantity / maxQ) * 100, 2), 100);
      },

      get volumeRemaining() {
        const n = this.nextVolumeDiscount;
        return n ? Math.max(parseInt(n.quantity) - this.quantity, 0) : 0;
      },

      get volumeSaved() {
        const d = this.getAppliedVolumeDiscount();
        if (!d) return null;
        const saved = this.variant.price * (parseFloat(d.percentage) / 100) * this.quantity;
        return saved.toFixed(2);
      },

      get volumeOriginalTotal() {
        return (this.variant.price * this.quantity).toFixed(2);
      },

      get volumeDiscountedTotal() {
        const d = this.getAppliedVolumeDiscount();
        const total = this.variant.price * this.quantity;
        if (!d) return total.toFixed(2);
        return (total - total * (parseFloat(d.percentage) / 100)).toFixed(2);
      },

      vdTrack: function () {
        const applied = this.getAppliedVolumeDiscount();
        const tierQ = applied ? parseInt(applied.quantity) : null;
        if (tierQ !== null && this.vdAppliedTier !== tierQ) {
          this.vdFlash = tierQ;
          setTimeout(() => { if (this.vdFlash === tierQ) this.vdFlash = null; }, 1300);
        }
        this.vdAppliedTier = tierQ;
      },

      get unitPrice() {
        const quantity = 1;

        let price = this.variant.price * quantity;

        // Apply volume discounts
        const appliedVolumeDiscount = this.getAppliedVolumeDiscount(quantity);
        if (appliedVolumeDiscount) {
          price = price - (this.variant.price * parseFloat(appliedVolumeDiscount.percentage) / 100);
        }

        // Format the price to have 2 decimal places
        const formattedPrice = price.toFixed(2);

        return formattedPrice;
      },

      get totalPrice() {
        let price = this.variant.price * this.quantity;
        let priceBeforeDiscounts = price;

        // Apply volume discounts
        const appliedVolumeDiscount = this.getAppliedVolumeDiscount();
        if (appliedVolumeDiscount) {
          price -= (priceBeforeDiscounts * parseFloat(appliedVolumeDiscount.percentage) / 100);
        }

        // Apply quantity deal discounts
        for (const deal of this.quantityDeals) {
          if (deal.variant_id !== null && deal.variant_id !== this.variant.id) continue;
          const bundleSize = deal.buy_quantity + deal.discounted_quantity;
          let applications = Math.floor(this.quantity / bundleSize);
          if (deal.max_uses_per_cart !== null) {
            applications = Math.min(applications, deal.max_uses_per_cart);
          }
          if (applications > 0) {
            price -= applications * deal.discounted_quantity * this.variant.price * (deal.percentage / 100);
          }
        }

        // Append prices of addons
        if (this.appCart.items.length > 0) {
          for (const item of this.appCart.items) {
            if (item.parentVariantId === this.variant.id) {
              const addonVariant = this.productAddons.find(addon => addon.id === item.productId && addon.variants.some(variant => variant.id === item.variantId));
              if (addonVariant) {
                const addonPrice = addonVariant.variants.find(variant => variant.id === item.variantId).price;
                price += addonPrice * item.quantity;
              }
            }
          }
        }

        // If price is negative, set it to 0
        if (price < 0) {
          price = 0;
        }

        // Format the price to have 2 decimal places
        const formattedPrice = price.toFixed(2);

        return formattedPrice;
      },

      get outOfStock() {
        if (this.variant) {
          if (this.variant.stock === 0) {
            return true;
          }

          if (this.variant.quantity_min > 0 && this.variant.stock !== -1 && !this.product.hide_stock_count && this.variant.stock < this.variant.quantity_min) {
            return true;
          }
        }

        return false;
      },

      get minQuantity() {
        const min = this.variant.quantity_min || 1;

        if (this.variant.stock === 0) {
          return 0;
        }

        return min;
      },

      get maxQuantity() {
        const max = this.variant.quantity_max || 999999;

        if (this.variant.stock === 0) {
          return 0;
        }

        if (this.product.hide_stock_count) {
          return max;
        }

        if (this.variant.stock === -1) {
          return max;
        }

        return Math.min(max, this.variant.stock);
      },

      changeQuantity: function (quantity) {
        const min = this.minQuantity;
        const max = this.maxQuantity;
        const newQuantity = Math.min(Math.max(min, quantity), max);

        this.quantity = newQuantity;
      },

      isBundleComplete: function (offerId) {
        const offer = window.__bundleOffers?.find(o => o.id === offerId);
        if (!offer) return false;
        return offer.items.every(item => {
          const required = item.quantity || 1;
          if (item.is_current) {
            const variantId = item.type === 'variant' ? item.id : this.variant.id;
            const entry = this.appCart.items.find(i => i.variantId === variantId && !i.parentVariantId);
            return entry && entry.quantity >= required;
          }
          if (item.type === 'variant') {
            const entry = this.appCart.items.find(i => i.variantId === item.id && !i.parentVariantId);
            return entry && entry.quantity >= required;
          }
          if (item.variants?.[0]) {
            const entry = this.appCart.items.find(i => i.variantId === item.variants[0].id && !i.parentVariantId);
            return entry && entry.quantity >= required;
          }
          return this.appCart.items.some(i => i.productId === item.id && !i.parentVariantId);
        });
      },

      addBundleItems: function (offerId) {
        const offer = window.__bundleOffers?.find(o => o.id === offerId);
        if (!offer) return;

        const currentItem = offer.items.find(item => item.is_current);
        const currentVariantId = currentItem && currentItem.type === 'variant'
          ? currentItem.id
          : this.variant.id;
        const variantIndex = this.product.variants.findIndex(variant => variant.id === currentVariantId);
        if (variantIndex !== -1 && variantIndex !== this.activeVariant) {
          const previousVariant = this.variant;
          this.activeVariant = variantIndex;

          const stillNeeded = offer.items.some(item => item.id === previousVariant.id && item.type === 'variant');
          if (!stillNeeded && this.appCart.isInCart(previousVariant.id)) {
            for (const addon of this.productAddons) {
              this.appCart.remove(addon.variants[0].id, previousVariant.id);
            }
            this.appCart.remove(previousVariant.id);
          }
        }

        let currentQuantity = null;

        for (const item of offer.items) {
          if (item.is_current) {
            if (!this.appCart.isInCart(currentVariantId)) {
              currentQuantity = item.quantity || this.quantity;
              this.appCart.add(this.product.id, currentVariantId, currentQuantity);
            }
            continue;
          }
          if (item.type === 'variant' && !this.appCart.isInCart(item.id)) {
            this.appCart.add(item.product_id, item.id, item.quantity);
          } else if (item.type === 'product' && item.variants?.[0]) {
            const variantId = item.variants[0].id;
            if (!this.appCart.isInCart(variantId)) {
              this.appCart.add(item.id, variantId, item.quantity);
            }
          }
        }

        this.$nextTick(() => {
          if (currentQuantity !== null) {
            this.quantity = currentQuantity;
            this.addedToCart = true;
          }
        });
      },

      get cartLimitReached() {
        const nonAddonItemsCount = this.appCart.items
          .filter(item => !item.parentVariantId)
          .length;

        return nonAddonItemsCount >= {{ shop.max_cart_limit }};
      },

      addToCart: function () {
        if (this.addedToCart) {
          window.location.href = '{{ '/cart' | shopUrl }}';
          return;
        }

        if (this.quantity < this.minQuantity || this.quantity > this.maxQuantity) {
          this.quantity = Math.min(Math.max(this.minQuantity, this.quantity), this.maxQuantity);
        }

        this.addingToCart = true;

        const productId = this.product.id;
        const variantId = this.variant.id;
        const quantity = this.quantity;

        this.appCart.add(productId, variantId, quantity);

        setTimeout(() => {
          this.addedToCart = true;
          this.addingToCart = false;
        }, 500);
      },

      removeFromCart: function (variantId) {
        if (this.variant && variantId === this.variant.id) {
          for (const addon of this.productAddons) {
            this.appCart.remove(addon.variants[0].id, variantId);
          }
        }

        this.appCart.remove(variantId);
      },

      addAltchaEventListener: function () {
        this.$refs.altcha.addEventListener('statechange', (event) => {
          if (event.detail.state === 'verifying') {
            this.buyNowDisabled = true;
          } else if (event.detail.state === 'verified') {
            this.buyNowDisabled = false;
            this.altchaPayload = event.detail.payload;
          }
        });
      },

      generateRecaptchaToken: async function () {
        return new Promise((resolve) => {
          grecaptcha.ready(
            () =>
              void (async () => {
                const token = await grecaptcha.execute(
                  '{{ shop.recaptcha_key }}',
                  { action: 'buynow_s{{ shop.id }}' },
                );

                resolve(token);
              })(),
          );
        });
      },

      /** The selected variant plus the addons attached to it, in the checkout cart shape. */
      purchaseCart: function (wantsSubscription = false) {
        const cart = [{
          productId: this.product.id,
          variantId: this.variant.id,
          quantity: wantsSubscription ? 1 : this.quantity,
          ...(wantsSubscription ? { subscribe: true } : {}),
        }];

        if (!wantsSubscription && this.appCart.items.length > 0) {
          for (const item of this.appCart.items) {
            if (item.parentVariantId === this.variant.id) {
              cart.push({
                productId: item.productId,
                variantId: item.variantId,
                parentVariantId: item.parentVariantId,
                quantity: item.quantity,
              });
            }
          }
        }

        return cart;
      },

      get customerBalance() {
        return Number(window.shopCustomer?.balance ?? 0);
      },

      get instantBalanceEligible() {
        if (!this.instantBalance?.enabled || !window.shopCustomer) {
          return false;
        }

        const variant = this.variant;

        if (!variant || variant.subscription_mode === 'required') {
          return false;
        }

        return !(variant.disabled_payment_method_ids || []).includes(this.instantBalance.payment_method_id);
      },

      /** Only gates the button; the quote is what actually prices the order. */
      get instantBalanceAffordable() {
        const estimate = this.appCurrency.convert(
          this.variant.price * this.quantity,
          this.product.currency,
          'USD',
        );

        return this.customerBalance >= estimate;
      },

      instantFormat: function (amount, currency) {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: (currency || 'USD').toUpperCase(),
          currencyDisplay: 'symbol',
        }).format(Number(amount ?? 0));
      },

      instantRequest: async function (path, body) {
        const token = Cookies.get('shop_customer_token');

        if (!token) {
          throw new Error('signed_out');
        }

        // apiBaseUrl carries a trailing slash in some themes and not others.
        const baseUrl = (window.apiBaseUrl || '').replace(/\/$/, '');

        const response = await fetch(`${baseUrl}/v1/customer-dashboard/instant-balance/${path}`, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        });

        if (response.status === 401 || response.status === 403) {
          Cookies.remove('shop_customer_token');
          throw new Error('signed_out');
        }

        const data = await response.json();

        if (!response.ok) {
          const error = new Error(data?.message || {{ ('product.instant_balance_error' | t) | json }});
          error.status = response.status;
          throw error;
        }

        return data;
      },

      openInstantBalance: async function () {
        if (this.instantLoading) {
          return;
        }

        if (this.quantity < this.minQuantity || this.quantity > this.maxQuantity) {
          this.quantity = Math.min(Math.max(this.minQuantity, this.quantity), this.maxQuantity);
        }

        this.instantLoading = true;
        this.instantError = null;
        this.instantQuote = null;
        this.instantOpen = true;

        try {
          this.instantQuote = await this.requestInstantQuote();
        } catch (error) {
          if (error.message === 'signed_out') {
            this.instantOpen = false;
            window.location.reload();
            return;
          }

          console.error(error);
          this.instantError = error.message;
        } finally {
          this.instantLoading = false;
        }
      },

      requestInstantQuote: async function () {
        const body = {
          cart: this.purchaseCart(),
          currency: this.product.currency,
        };

        try {
          const storedAffiliate = JSON.parse(localStorage.getItem('affiliate'));
          if (storedAffiliate?.code && (!storedAffiliate.expires || Date.now() <= storedAffiliate.expires)) {
            body.affiliate = storedAffiliate.code;
          }
        } catch {}

        return this.instantRequest('quote', body);
      },

      closeInstantBalance: function () {
        this.instantOpen = false;
        this.instantQuote = null;
        this.instantError = null;
      },

      confirmInstantBalance: async function () {
        if (this.instantPaying || !this.instantQuote) {
          return;
        }

        this.instantPaying = true;
        this.instantError = null;

        try {
          const data = await this.instantRequest(`${this.instantQuote.unique_id}/pay`, {
            quoted_total_usd: this.instantQuote.price_usd,
          });

          window.location.href = data.url;
          return;
        } catch (error) {
          if (error.message === 'signed_out') {
            this.instantOpen = false;
            window.location.reload();
            return;
          }

          console.error(error);

          if (error.status === 409) {
            this.instantError = {{ ('product.instant_balance_price_changed' | t) | json }};

            try {
              this.instantQuote = await this.requestInstantQuote();
            } catch {}
          } else {
            this.instantError = error.message;
          }
        } finally {
          this.instantPaying = false;
        }
      },

      buyNow: async function () {
        if (this.buyingNow) {
          return;
        }

        if (this.quantity < this.minQuantity || this.quantity > this.maxQuantity) {
          this.buyNowError = {{ ('product.quantity_invalid' | t) | json }}.replace('{min}', this.minQuantity).replace('{max}', this.maxQuantity);
          return;
        }

        // Subscriptions are always single-item, quantity-1 checkouts (no addons).
        const wantsSubscription = this.subscribeIntent || this.variant.subscription_mode === 'required';

        const formData = {
          cart: this.purchaseCart(wantsSubscription),
          currency: this.appCurrency.currency,
          shopId: '{{ shop.id }}',
          source: 'storefront',
        };

        if (window.shopCustomer?.email) {
          formData.email = window.shopCustomer.email;
        }

        {% if altcha %}
          if (this.altchaPayload) {
            formData.altcha = this.altchaPayload;
          }
        {% elif shop.recaptcha_key %}
          try {
            formData.recaptchaToken = await this.generateRecaptchaToken();
          } catch (error) {
            this.buyNowError = {{ ('common.recaptcha_error' | t) | json }};
            this.buyingNow = false;
            return;
          }
        {% endif %}

        try {
          this.buyingNow = true;

          const response = await fetch('{{ '/v1/checkout' | apiInternalUrl }}', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData),
          });

          const responseData = await response.json();

          if (responseData.url) {
            window.location.href = responseData.url;
          } else {
            this.buyingNow = false;
            this.buyNowError = responseData?.message || {{ ('common.request_error' | t) | json }};

            if (responseData?.error == 'captcha_verification_failed') {
              setTimeout(() => window.location.reload(), 1000);
            }
          }
        } catch (error) {
          console.error(error);
          this.buyingNow = false;
          this.buyNowError = {{ ('common.unexpected_error' | t) | json }};
        }
      }
    }));
  });
</script>

<script>
  window.addEventListener('load', () => {
    if (document.querySelector('select[name="variant"]')) {
     new Choices('select[name="variant"]', { searchPlaceholderValue: {{ ('product.search_variant_placeholder' | t) | json }}, shouldSort: false });
    }
  });
</script>